// ネイティブ実行ファイルに入る実行時部品。YuiLang で書き、利用側と同じコンパイラで機械語にする。
//
// ここだけで使える組み込み関数:
//   __load(address) -> Int        その番地の 8 バイトを読む
//   __store(address, value)       その番地に 8 バイトを書く
//   __alloc(bytes) -> Int         メモリを確保して番地を返す
//   __realloc(address, bytes) -> Int   大きさを変えて（移動するかもしれない）番地を返す
//   __free(address)               メモリを返す
//   __load8(address) -> Int       その番地の 1 バイトを読む（0〜255）
//   __store8(address, value)      その番地に 1 バイトを書く
//   __copy(to, from, bytes)       メモリを写す
//   __shr(value, bits) -> Int     右に bits ビットずらす（上は 0 で埋める）
//   __shl(value, bits) -> Int     左に bits ビットずらす
//   __and(a, b) -> Int            ビットごとの AND
//   __xor(a, b) -> Int            ビットごとの XOR
//   __load32(address) -> Int      その番地の 4 バイトを読む（0 以上の数として）
//   __store32(address, value)     その番地に 4 バイトを書く
//   __global(番号) -> Int          呼び出しをまたいで値を置いておくマス（8 バイト、最初は 0）の番地
//   __import_<名前>() -> Int       OS の関数の番地
//   __os_<名前>(...) -> Int        OS（kernel32）の関数を呼ぶ。使えるものは native.rs の OS_CALLS にある。
//                                 32 ビットの結果を返す関数は、上位に何が入っているか決まっていないので
//                                 __and(結果, 4294967295) で取り出す
//
// 足し算・引き算・掛け算は溢れを調べない。単項のマイナスと、定数以外での割り算は使わない
// （エラー表示がこのファイルの位置を指せないため）。
//
// リスト（List<Int>）の形: 先頭から 8 バイトずつ [参照カウント][長さ][容量][要素 0][要素 1]...

fn list_new(capacity: Int) -> Int {
  let list = __alloc(24 + capacity * 8)
  __store(list, 1)
  __store(list + 8, 0)
  __store(list + 16, capacity)
  list
}

// 持ち主が 1 人減る。最後の 1 人だったらメモリを返す
fn list_release(list: Int) {
  let count = __load(list)
  if count == 1 { __free(list) } else { __store(list, count - 1) }
}

// list の末尾に value を足したリストを返す。list の持ち主 1 人分を受け取り、返すリストの持ち主 1 人分を渡す。
// ほかに持ち主がいなければその場で足し、いれば複製してから足す（ほかの持ち主からは変わって見えない）
fn list_push(list: Int, value: Int) -> Int {
  let count = __load(list)
  let length = __load(list + 8)
  let capacity = __load(list + 16)
  if count == 1 {
    if length < capacity {
      __store(list + 24 + length * 8, value)
      __store(list + 8, length + 1)
      return list
    }
    let room = capacity * 2 + 8
    let grown = __realloc(list, 24 + room * 8)
    __store(grown + 16, room)
    __store(grown + 24 + length * 8, value)
    __store(grown + 8, length + 1)
    return grown
  }
  let copy = list_new(length * 2 + 8)
  let mut i = 0
  while i < length {
    __store(copy + 24 + i * 8, __load(list + 24 + i * 8))
    i = i + 1
  }
  __store(copy + 24 + length * 8, value)
  __store(copy + 8, length + 1)
  __store(list, count - 1)
  copy
}

// あと extra 個入るように容量を広げて返す（移動するかもしれない）。
// 持ち主が 1 人のときだけ。共有されているリストは、追加のときに複製されるのでそのまま返す
fn list_reserve(list: Int, extra: Int) -> Int {
  if extra <= 0 { return list }
  if __load(list) != 1 { return list }
  let needed = __load(list + 8) + extra
  if needed <= __load(list + 16) { return list }
  let grown = __realloc(list, 24 + needed * 8)
  __store(grown + 16, needed)
  grown
}

// a の後ろに b をつないだ新しいリスト。要素は写すだけで、数え直しは呼び出し側がする
fn list_concat(a: Int, b: Int) -> Int {
  let n = __load(a + 8)
  let m = __load(b + 8)
  let out = list_new(n + m)
  __copy(out + 24, a + 24, n * 8)
  __copy(out + 24 + n * 8, b + 24, m * 8)
  __store(out + 8, n + m)
  out
}

fn list_reversed(a: Int) -> Int {
  let n = __load(a + 8)
  let out = list_new(n)
  let mut i = 0
  while i < n {
    __store(out + 24 + i * 8, __load(a + 16 + (n - i) * 8))
    i = i + 1
  }
  __store(out + 8, n)
  out
}

fn list_contains(a: Int, value: Int) -> Int {
  let n = __load(a + 8)
  let mut i = 0
  while i < n {
    if __load(a + 24 + i * 8) == value { return 1 }
    i = i + 1
  }
  0
}

fn list_contains_str(a: Int, value: Int) -> Int {
  let n = __load(a + 8)
  let mut i = 0
  while i < n {
    if str_eq(__load(a + 24 + i * 8), value) == 1 { return 1 }
    i = i + 1
  }
  0
}

// x が y より前なら 1。strings が 1 なら文字列として比べる
fn before(x: Int, y: Int, strings: Int) -> Int {
  if strings == 1 { if str_cmp(x, y) < 0 { 1 } else { 0 } } else if x < y { 1 } else { 0 }
}

// ヒープソートの部品: start の要素を、end より前の範囲で正しい位置まで沈める
fn sift(base: Int, start: Int, end: Int, strings: Int) {
  let mut root = start
  while root * 2 + 1 < end {
    let mut child = root * 2 + 1
    if child + 1 < end && before(__load(base + child * 8), __load(base + child * 8 + 8), strings) == 1 {
      child = child + 1
    }
    let top = __load(base + root * 8)
    let below = __load(base + child * 8)
    if before(top, below, strings) == 1 {
      __store(base + root * 8, below)
      __store(base + child * 8, top)
      root = child
    } else {
      return
    }
  }
}

// 昇順に並べた新しいリスト（ヒープソート）
fn list_sorted(a: Int, strings: Int) -> Int {
  let n = __load(a + 8)
  let out = list_new(n)
  __copy(out + 24, a + 24, n * 8)
  __store(out + 8, n)
  let base = out + 24
  let mut start = n / 2
  while start > 0 {
    start = start - 1
    sift(base, start, n, strings)
  }
  let mut end = n
  while end > 1 {
    end = end - 1
    let first = __load(base)
    __store(base, __load(base + end * 8))
    __store(base + end * 8, first)
    sift(base, 0, end, strings)
  }
  out
}

// 文字列のリストを sep でつないだ文字列
fn list_join(a: Int, sep: Int) -> Int {
  let n = __load(a + 8)
  let mut out = str_new(16)
  let mut i = 0
  while i < n {
    if i > 0 {
      out = str_append_str(out, sep)
    }
    out = str_append_str(out, __load(a + 24 + i * 8))
    i = i + 1
  }
  out
}

// Map の形: [参照カウント][件数][容量] のあとに、16 バイトずつ [キー][値] がキーの昇順で並ぶ

fn map_new(capacity: Int) -> Int {
  let m = __alloc(24 + capacity * 16)
  __store(m, 1)
  __store(m + 8, 0)
  __store(m + 16, capacity)
  m
}

// key のある位置。なければ「-1 - 入れるべき位置」。strings が 1 ならキーは文字列
fn map_find(m: Int, key: Int, strings: Int) -> Int {
  let mut low = 0
  let mut high = __load(m + 8)
  while low < high {
    let middle = (low + high) / 2
    let here = __load(m + 24 + middle * 16)
    let mut order = 0
    if strings == 1 {
      order = str_cmp(here, key)
    } else if here < key {
      order = 0 - 1
    } else if here > key {
      order = 1
    }
    if order == 0 { return middle }
    if order < 0 {
      low = middle + 1
    } else {
      high = middle
    }
  }
  0 - 1 - low
}

// at 番目の値を入れ替えて、前の値を返す
fn map_swap(m: Int, at: Int, value: Int) -> Int {
  let place = m + 32 + at * 16
  let old = __load(place)
  __store(place, value)
  old
}

// at 番目に [key][value] を割り込ませる。持ち主が 1 人の Map にだけ使う（移動するかもしれない）
fn map_insert(m: Int, at: Int, key: Int, value: Int) -> Int {
  let count = __load(m + 8)
  let mut out = m
  if count == __load(m + 16) {
    let room = count * 2 + 4
    out = __realloc(m, 24 + room * 16)
    __store(out + 16, room)
  }
  let mut i = count
  while i > at {
    __store(out + 24 + i * 16, __load(out + 8 + i * 16))
    __store(out + 32 + i * 16, __load(out + 16 + i * 16))
    i = i - 1
  }
  __store(out + 24 + at * 16, key)
  __store(out + 32 + at * 16, value)
  __store(out + 8, count + 1)
  out
}

// at 番目を取り除いて詰める。持ち主が 1 人の Map にだけ使う
fn map_close(m: Int, at: Int) {
  let count = __load(m + 8) - 1
  let mut i = at
  while i < count {
    __store(m + 24 + i * 16, __load(m + 40 + i * 16))
    __store(m + 32 + i * 16, __load(m + 48 + i * 16))
    i = i + 1
  }
  __store(m + 8, count)
}

// キー（offset が 24）か値（32）を順に並べた新しいリスト。数え直しは呼び出し側がする
fn map_column(m: Int, offset: Int) -> Int {
  let count = __load(m + 8)
  let out = list_new(count)
  let mut i = 0
  while i < count {
    __store(out + 24 + i * 8, __load(m + offset + i * 16))
    i = i + 1
  }
  __store(out + 8, count)
  out
}

fn map_keys(m: Int) -> Int {
  map_column(m, 24)
}

fn map_values(m: Int) -> Int {
  map_column(m, 32)
}

// from 番目から to 番目の手前までを写した新しいリスト。数え直しは呼び出し側がする
fn list_slice(a: Int, from: Int, to: Int) -> Int {
  let n = to - from
  let out = list_new(n)
  __copy(out + 24, a + 24 + from * 8, n * 8)
  __store(out + 8, n)
  out
}

// 文字列の形: 先頭から [参照カウント][バイト数][容量][UTF-8 のバイト列]。
// 参照カウントが負のものはプログラムに埋め込まれた定数で、解放も書き換えもしない

fn str_new(capacity: Int) -> Int {
  let s = __alloc(24 + capacity)
  __store(s, 1)
  __store(s + 8, 0)
  __store(s + 16, capacity)
  s
}

fn str_release(s: Int) {
  let count = __load(s)
  if count == 1 { __free(s) } else if count > 1 { __store(s, count - 1) }
}

// ここから下の str_append 系は、作りかけの文字列（持ち主が 1 人で、定数でない）にだけ使う。
// あと extra バイト入るようにして返す（移動するかもしれない）
fn str_reserve(s: Int, extra: Int) -> Int {
  let length = __load(s + 8)
  if length + extra <= __load(s + 16) { return s }
  let room = (length + extra) * 2
  let grown = __realloc(s, 24 + room)
  __store(grown + 16, room)
  grown
}

fn str_append(s: Int, source: Int, count: Int) -> Int {
  let out = str_reserve(s, count)
  let length = __load(out + 8)
  __copy(out + 24 + length, source, count)
  __store(out + 8, length + count)
  out
}

fn str_append_str(s: Int, piece: Int) -> Int {
  str_append(s, piece + 24, __load(piece + 8))
}

// 10 進表記を足す。最小の整数も扱えるように、負の数のまま桁を取り出す
fn str_append_int(s: Int, value: Int) -> Int {
  let out = str_reserve(s, 20)
  let length = __load(out + 8)
  let mut n = value
  if n > 0 {
    n = 0 - n
  }
  let mut digits = 1
  let mut rest = n / 10
  while rest != 0 {
    digits = digits + 1
    rest = rest / 10
  }
  let mut at = out + 24 + length
  let mut written = digits
  if value < 0 {
    __store8(at, 45)
    at = at + 1
    written = written + 1
  }
  let mut i = digits
  while i > 0 {
    i = i - 1
    __store8(at + i, 48 - n % 10)
    n = n / 10
  }
  __store(out + 8, length + written)
  out
}

// 引用符で囲み、特別な文字を \ 付きの表記にして足す（値の中にある文字列の見せ方）
fn str_append_quoted(s: Int, piece: Int) -> Int {
  let count = __load(piece + 8)
  // いちばん長くなるのは制御文字の \u{7f}（6 バイト）
  let out = str_reserve(s, count * 6 + 2)
  let start = out + 24
  let mut at = start + __load(out + 8)
  __store8(at, 34)
  at = at + 1
  let mut i = 0
  while i < count {
    let byte = __load8(piece + 24 + i)
    if byte == 34 || byte == 92 {
      __store8(at, 92)
      __store8(at + 1, byte)
      at = at + 2
    } else if byte == 10 {
      __store8(at, 92)
      __store8(at + 1, 110)
      at = at + 2
    } else if byte == 13 {
      __store8(at, 92)
      __store8(at + 1, 114)
      at = at + 2
    } else if byte == 9 {
      __store8(at, 92)
      __store8(at + 1, 116)
      at = at + 2
    } else if byte == 0 {
      __store8(at, 92)
      __store8(at + 1, 48)
      at = at + 2
    } else if byte < 32 || byte == 127 {
      __store8(at, 92)
      __store8(at + 1, 117)
      __store8(at + 2, 123)
      at = at + 3
      if byte >= 16 {
        __store8(at, 48 + byte / 16)
        at = at + 1
      }
      let low = byte % 16
      if low < 10 { __store8(at, 48 + low) } else { __store8(at, 87 + low) }
      __store8(at + 1, 125)
      at = at + 2
    } else {
      __store8(at, byte)
      at = at + 1
    }
    i = i + 1
  }
  __store8(at, 34)
  __store(out + 8, at + 1 - start)
  out
}

fn str_from_int(value: Int) -> Int {
  str_append_int(str_new(20), value)
}

// count バイトが同じなら 1。8 バイトずつ比べ、端数は 1 バイトずつ
fn bytes_equal(a: Int, b: Int, count: Int) -> Int {
  let mut i = 0
  while i + 8 <= count {
    if __load(a + i) != __load(b + i) { return 0 }
    i = i + 8
  }
  while i < count {
    if __load8(a + i) != __load8(b + i) { return 0 }
    i = i + 1
  }
  1
}

fn str_eq(a: Int, b: Int) -> Int {
  let count = __load(a + 8)
  if count != __load(b + 8) { return 0 }
  bytes_equal(a + 24, b + 24, count)
}

// 辞書順で a が前なら負、同じなら 0、後なら正。UTF-8 はバイト順と文字コード順が一致する
fn str_cmp(a: Int, b: Int) -> Int {
  let a_count = __load(a + 8)
  let b_count = __load(b + 8)
  let mut i = 0
  while i < a_count && i < b_count {
    let x = __load8(a + 24 + i)
    let y = __load8(b + 24 + i)
    if x != y { return x - y }
    i = i + 1
  }
  a_count - b_count
}

// 文字数。UTF-8 の続きのバイト（128〜191）は数えない
fn str_chars(s: Int) -> Int {
  let count = __load(s + 8)
  let mut chars = 0
  let mut i = 0
  while i < count {
    let byte = __load8(s + 24 + i)
    if byte < 128 || byte > 191 {
      chars = chars + 1
    }
    i = i + 1
  }
  chars
}

fn str_is_empty(s: Int) -> Int {
  if __load(s + 8) == 0 { 1 } else { 0 }
}

fn str_starts_with(s: Int, part: Int) -> Int {
  let count = __load(part + 8)
  if count > __load(s + 8) { return 0 }
  bytes_equal(s + 24, part + 24, count)
}

fn str_ends_with(s: Int, part: Int) -> Int {
  let count = __load(part + 8)
  let length = __load(s + 8)
  if count > length { return 0 }
  bytes_equal(s + 24 + length - count, part + 24, count)
}

fn str_contains(s: Int, part: Int) -> Int {
  let count = __load(part + 8)
  let last = __load(s + 8) - count
  let mut i = 0
  while i <= last {
    if bytes_equal(s + 24 + i, part + 24, count) == 1 { return 1 }
    i = i + 1
  }
  0
}

// s の from バイト目から to バイト目の手前までを写した新しい文字列
fn str_piece(s: Int, from: Int, to: Int) -> Int {
  let out = str_new(to - from)
  __copy(out + 24, s + 24 + from, to - from)
  __store(out + 8, to - from)
  out
}

// 1 文字ずつの文字列のリスト。UTF-8 の続きのバイト（128〜191）の前では切らない
fn str_chars_list(s: Int) -> Int {
  let count = __load(s + 8)
  let mut out = list_new(count)
  let mut start = 0
  let mut i = 1
  while i <= count {
    let mut boundary = 1
    if i < count {
      let byte = __load8(s + 24 + i)
      if byte >= 128 && byte <= 191 {
        boundary = 0
      }
    }
    if boundary == 1 {
      out = list_push(out, str_piece(s, start, i))
      start = i
    }
    i = i + 1
  }
  out
}

// sep で区切った文字列のリスト。sep が空なら 1 文字ずつ
fn str_split(s: Int, sep: Int) -> Int {
  let count = __load(s + 8)
  let width = __load(sep + 8)
  if width == 0 { return str_chars_list(s) }
  let mut out = list_new(4)
  let mut start = 0
  let mut i = 0
  while i + width <= count {
    if bytes_equal(s + 24 + i, sep + 24, width) == 1 {
      out = list_push(out, str_piece(s, start, i))
      i = i + width
      start = i
    } else {
      i = i + 1
    }
  }
  list_push(out, str_piece(s, start, count))
}

fn str_is_ascii(s: Int) -> Int {
  let count = __load(s + 8)
  let mut i = 0
  while i < count {
    if __load8(s + 24 + i) >= 128 { return 0 }
    i = i + 1
  }
  1
}

// first から 26 文字（大文字なら 65、小文字なら 97）を、もう一方の大小に変えた新しい文字列
fn str_shift_case(s: Int, first: Int) -> Int {
  let count = __load(s + 8)
  let out = str_new(count)
  let mut i = 0
  while i < count {
    let byte = __load8(s + 24 + i)
    if byte >= first && byte < first + 26 {
      __store8(out + 24 + i, byte + 162 - first * 2)
    } else {
      __store8(out + 24 + i, byte)
    }
    i = i + 1
  }
  __store(out + 8, count)
  out
}

fn str_push(s: Int, byte: Int) -> Int {
  let out = str_reserve(s, 1)
  let length = __load(out + 8)
  __store8(out + 24 + length, byte)
  __store(out + 8, length + 1)
  out
}

// ここから小数を文字列にする部品。
// 大きな整数: 32 ビットずつを 8 バイトのマスに入れ、下の桁から 80 マス並べる（2560 ビット。
// いちばん小さい小数といちばん大きい小数の計算が、どちらも収まる）

fn big_set(a: Int, value: Int) {
  let mut i = 2
  while i < 80 {
    __store(a + i * 8, 0)
    i = i + 1
  }
  __store(a, __and(value, 4294967295))
  __store(a + 8, __shr(value, 32))
}

fn big_copy(to: Int, from: Int) {
  __copy(to, from, 640)
}

// a = a * factor（factor は 2 の 31 乗未満）
fn big_mul(a: Int, factor: Int) {
  let mut carry = 0
  let mut i = 0
  while i < 80 {
    let v = __load(a + i * 8) * factor + carry
    __store(a + i * 8, __and(v, 4294967295))
    carry = __shr(v, 32)
    i = i + 1
  }
}

// a = a * 2 の bits 乗
fn big_shift(a: Int, bits: Int) {
  let mut rest = bits
  while rest >= 30 {
    big_mul(a, 1073741824)
    rest = rest - 30
  }
  if rest > 0 { big_mul(a, __shl(1, rest)) }
}

fn big_add(a: Int, b: Int) {
  let mut carry = 0
  let mut i = 0
  while i < 80 {
    let v = __load(a + i * 8) + __load(b + i * 8) + carry
    __store(a + i * 8, __and(v, 4294967295))
    carry = __shr(v, 32)
    i = i + 1
  }
}

// a = a - b（a が b 以上のときだけ）
fn big_sub(a: Int, b: Int) {
  let mut borrow = 0
  let mut i = 0
  while i < 80 {
    let mut v = __load(a + i * 8) - __load(b + i * 8) - borrow
    borrow = 0
    if v < 0 {
      v = v + 4294967296
      borrow = 1
    }
    __store(a + i * 8, v)
    i = i + 1
  }
}

// a が b より小さければ負、同じなら 0、大きければ正
fn big_cmp(a: Int, b: Int) -> Int {
  let mut i = 80
  while i > 0 {
    i = i - 1
    let x = __load(a + i * 8)
    let y = __load(b + i * 8)
    if x != y { return x - y }
  }
  0
}

// 小数（64 ビットの中身が bits）を、その値に戻せるいちばん短い桁数の 10 進表記で足す。
// 指数表記は使わない。整数値で 10 の 16 乗未満なら ".0" を付ける。
//
// 求め方: 値を r / s という分数で持ち、隣の小数との中間までの幅を plus / s、minus / s で持つ。
// 桁を 1 つずつ取り出し、残りが幅の中に入ったら、それ以上の桁は要らない（Steele と White、
// Burger と Dybvig の方法）
fn str_append_float(s: Int, bits: Int) -> Int {
  let negative = __shr(bits, 63)
  let exponent = __and(__shr(bits, 52), 2047)
  let fraction = __and(bits, 4503599627370495)
  let mut out = s
  if exponent == 2047 {
    if fraction != 0 { return str_push(str_push(str_push(out, 78), 97), 78) }
    if negative == 1 {
      out = str_push(out, 45)
    }
    return str_push(str_push(str_push(out, 105), 110), 102)
  }
  if negative == 1 {
    out = str_push(out, 45)
  }
  if exponent == 0 && fraction == 0 { return str_push(str_push(str_push(out, 48), 46), 48) }

  // 値 = mantissa * 2 の power 乗
  let mut mantissa = fraction
  let mut power = 0 - 1074
  if exponent != 0 {
    mantissa = fraction + 4503599627370496
    power = exponent - 1075
  }
  // 仮数が偶数なら、幅のちょうど端も「この値に戻る」範囲に入る
  let even = 1 - __and(mantissa, 1)
  // 仮数が 2 の累乗ちょうどのとき、下側の隣は半分の近さにある
  let mut narrow = 0
  if fraction == 0 && exponent > 1 {
    narrow = 1
  }
  let work = __alloc(3600)
  let r = work
  let scale = work + 640
  let plus = work + 1280
  let minus = work + 1920
  let sum = work + 2560
  let digits = work + 3200
  big_set(r, mantissa)
  big_set(scale, 1)
  big_set(plus, 1)
  big_set(minus, 1)
  if power >= 0 {
    big_shift(r, power + 1 + narrow)
    big_shift(scale, 1 + narrow)
    big_shift(plus, power + narrow)
    big_shift(minus, power)
  } else {
    big_shift(r, 1 + narrow)
    big_shift(scale, 1 + narrow - power)
    big_shift(plus, narrow)
  }

  // point: 小数点の位置。値 = 0.d1 d2 d3... * 10 の point 乗 になるように合わせる
  let mut point = 0
  let mut fitting = 1
  while fitting == 1 {
    big_copy(sum, r)
    big_add(sum, plus)
    if float_reaches(sum, scale, even) == 1 {
      big_mul(scale, 10)
      point = point + 1
    } else {
      fitting = 0
    }
  }
  fitting = 1
  while fitting == 1 {
    big_copy(sum, r)
    big_add(sum, plus)
    big_mul(sum, 10)
    if float_reaches(sum, scale, even) == 1 {
      fitting = 0
    } else {
      big_mul(r, 10)
      big_mul(plus, 10)
      big_mul(minus, 10)
      point = point - 1
    }
  }

  // 桁を取り出す
  let mut count = 0
  let mut going = 1
  while going == 1 {
    big_mul(r, 10)
    big_mul(plus, 10)
    big_mul(minus, 10)
    let mut digit = 0
    while big_cmp(r, scale) >= 0 {
      big_sub(r, scale)
      digit = digit + 1
    }
    // low: ここで止めても下側の幅に収まる。high: 1 つ上げても上側の幅に収まる
    let below = big_cmp(r, minus)
    let mut low = 0
    if below < 0 || below == 0 && even == 1 {
      low = 1
    }
    big_copy(sum, r)
    big_add(sum, plus)
    let high = float_reaches(sum, scale, even)
    if low == 1 || high == 1 {
      going = 0
      if low == 0 {
        digit = digit + 1
      } else if high == 1 {
        // どちらでもよいときは、近いほう。ちょうど真ん中なら偶数の桁にする
        big_copy(sum, r)
        big_mul(sum, 2)
        let half = big_cmp(sum, scale)
        if half > 0 || half == 0 && __and(digit, 1) == 1 {
          digit = digit + 1
        }
      }
    }
    __store8(digits + count, 48 + digit)
    count = count + 1
  }

  // 並べる
  let mut i = 0
  if point <= 0 {
    out = str_push(str_push(out, 48), 46)
    while i < 0 - point {
      out = str_push(out, 48)
      i = i + 1
    }
    out = str_append(out, digits, count)
  } else if point >= count {
    out = str_append(out, digits, count)
    i = count
    while i < point {
      out = str_push(out, 48)
      i = i + 1
    }
    if point <= 16 {
      out = str_push(str_push(out, 46), 48)
    }
  } else {
    out = str_append(out, digits, point)
    out = str_push(out, 46)
    out = str_append(out, digits + point, count - point)
  }
  __free(work)
  out
}

// sum が scale に届いているか（even なら、ちょうど同じでも届いたことにする）
fn float_reaches(sum: Int, scale: Int, even: Int) -> Int {
  let order = big_cmp(sum, scale)
  if order > 0 || order == 0 && even == 1 { 1 } else { 0 }
}

// UTF-8 の先頭バイトから、その文字が何バイトか
fn utf8_width(byte: Int) -> Int {
  if byte < 128 { 1 } else if byte < 224 { 2 } else if byte < 240 { 3 } else { 4 }
}

// address から始まる 1 文字の文字コード
fn utf8_code(address: Int) -> Int {
  let first = __load8(address)
  if first < 128 { return first }
  if first < 224 { return (first - 192) * 64 + __load8(address + 1) - 128 }
  if first < 240 {
    return (first - 224) * 4096 + (__load8(address + 1) - 128) * 64 + __load8(address + 2) - 128
  }
  (first - 240) * 262144 + (__load8(address + 1) - 128) * 4096 + (__load8(address + 2) - 128) * 64 + __load8(address + 3) - 128
}

// 文字コードが空白か（Unicode の White_Space）
fn is_space(code: Int) -> Int {
  if code == 32 || code >= 9 && code <= 13 { return 1 }
  if code < 133 { return 0 }
  if code == 133 || code == 160 || code == 5760 || code == 8232 || code == 8233 { return 1 }
  if code >= 8192 && code <= 8202 { return 1 }
  if code == 8239 || code == 8287 || code == 12288 { return 1 }
  0
}

// 先頭の空白を飛ばした位置（バイト数）
fn str_trim_start(s: Int) -> Int {
  let count = __load(s + 8)
  let mut i = 0
  while i < count {
    if is_space(utf8_code(s + 24 + i)) == 0 { break }
    i = i + utf8_width(__load8(s + 24 + i))
  }
  i
}

// 末尾の空白を除いた終わりの位置（バイト数）。start より前には戻らない
fn str_trim_end(s: Int, start: Int) -> Int {
  let mut end = __load(s + 8)
  while end > start {
    // 最後の文字の先頭を探す（続きのバイトは 128〜191）
    let mut at = end - 1
    while at > start && __load8(s + 24 + at) >= 128 && __load8(s + 24 + at) <= 191 {
      at = at - 1
    }
    if is_space(utf8_code(s + 24 + at)) == 0 { break }
    end = at
  }
  end
}

fn str_trim(s: Int) -> Int {
  let start = str_trim_start(s)
  str_piece(s, start, str_trim_end(s, start))
}

// 前後の空白を除いた部分が整数の表記なら 1 を返し、その値を result の番地に書く。
// 符号は先頭に 1 つだけ、あとは数字が 1 つ以上。Int に収まらなければ 0
fn str_parse_int(s: Int, result: Int) -> Int {
  let start = str_trim_start(s)
  let end = str_trim_end(s, start)
  let mut i = start
  let mut negative = 0
  if i < end {
    let sign = __load8(s + 24 + i)
    if sign == 45 {
      negative = 1
      i = i + 1
    } else if sign == 43 {
      i = i + 1
    }
  }
  if i >= end { return 0 }
  // いちばん小さい整数まで届くように、負の数として積み上げる
  let lowest = 0 - 9223372036854775807 - 1
  let mut value = 0
  while i < end {
    let digit = __load8(s + 24 + i) - 48
    if digit < 0 || digit > 9 { return 0 }
    if value < 0 - 922337203685477580 { return 0 }
    value = value * 10
    if value < lowest + digit { return 0 }
    value = value - digit
    i = i + 1
  }
  if negative == 0 {
    if value == lowest { return 0 }
    value = 0 - value
  }
  __store(result, value)
  1
}

// chars 文字目が始まる位置（バイト数）。文字数ちょうどなら末尾
fn str_offset(s: Int, chars: Int) -> Int {
  let count = __load(s + 8)
  let mut i = 0
  let mut seen = 0
  while i < count && seen < chars {
    i = i + utf8_width(__load8(s + 24 + i))
    seen = seen + 1
  }
  i
}

// from 文字目から to 文字目の手前までの新しい文字列
fn str_slice(s: Int, from: Int, to: Int) -> Int {
  let start = str_offset(s, from)
  str_piece(s, start, str_offset(s, to))
}

// s の中の from をすべて to に置き換えた新しい文字列。from が空なら s の写し
fn str_replace(s: Int, from: Int, to: Int) -> Int {
  let count = __load(s + 8)
  let width = __load(from + 8)
  if width == 0 { return str_piece(s, 0, count) }
  let mut out = str_new(count)
  let mut start = 0
  let mut i = 0
  while i + width <= count {
    if bytes_equal(s + 24 + i, from + 24, width) == 1 {
      out = str_append(out, s + 24 + start, i - start)
      out = str_append_str(out, to)
      i = i + width
      start = i
    } else {
      i = i + 1
    }
  }
  str_append(out, s + 24 + start, count - start)
}

// 各文字の文字コードのリスト
fn str_codes(s: Int) -> Int {
  let count = __load(s + 8)
  let mut out = list_new(count)
  let mut i = 0
  while i < count {
    out = list_push(out, utf8_code(s + 24 + i))
    i = i + utf8_width(__load8(s + 24 + i))
  }
  out
}

// 文字コード 1 つからなる文字列（UTF-8 にする）
fn str_from_code(code: Int) -> Int {
  let s = str_new(4)
  if code < 128 { return str_push(s, code) }
  if code < 2048 { return str_push(str_push(s, 192 + code / 64), 128 + code % 64) }
  if code < 65536 {
    return str_push(str_push(str_push(s, 224 + code / 4096), 128 + code / 64 % 64), 128 + code % 64)
  }
  let lead = str_push(str_push(s, 240 + code / 262144), 128 + code / 4096 % 64)
  str_push(str_push(lead, 128 + code / 64 % 64), 128 + code % 64)
}

// 文字コード 1 つを UTF-8 にして足す
fn str_push_code(s: Int, code: Int) -> Int {
  if code < 128 { return str_push(s, code) }
  if code < 2048 { return str_push(str_push(s, 192 + code / 64), 128 + code % 64) }
  if code < 65536 {
    return str_push(str_push(str_push(s, 224 + code / 4096), 128 + code / 64 % 64), 128 + code % 64)
  }
  let lead = str_push(str_push(s, 240 + code / 262144), 128 + code / 4096 % 64)
  str_push(str_push(lead, 128 + code / 64 % 64), 128 + code % 64)
}

// ここから OS とのやりとり。Windows の文字列は UTF-16（2 バイトずつ）

// address にある UTF-16 の 1 単位
fn wide_unit(address: Int) -> Int {
  __load8(address) + __load8(address + 1) * 256
}

// address から units 単位ぶんの UTF-16 を UTF-8 にして足す
fn str_append_wide(s: Int, address: Int, units: Int) -> Int {
  let mut out = s
  let mut i = 0
  while i < units {
    let unit = wide_unit(address + i * 2)
    if unit >= 55296 && unit <= 56319 && i + 1 < units {
      // 2 単位で 1 文字
      let low = wide_unit(address + i * 2 + 2)
      out = str_push_code(out, 65536 + (unit - 55296) * 1024 + low - 56320)
      i = i + 2
    } else {
      out = str_push_code(out, unit)
      i = i + 1
    }
  }
  out
}

// s を UTF-16 にして、0 で終わる形で新しく確保した場所に書く。使い終わったら __free で返す
fn wide_copy(s: Int) -> Int {
  let count = __load(s + 8)
  let out = __alloc(count * 2 + 2)
  let mut at = out
  let mut i = 0
  while i < count {
    let mut code = utf8_code(s + 24 + i)
    i = i + utf8_width(__load8(s + 24 + i))
    if code >= 65536 {
      code = code - 65536
      let high = 55296 + code / 1024
      __store8(at, high % 256)
      __store8(at + 1, high / 256)
      at = at + 2
      code = 56320 + code % 1024
    }
    __store8(at, code % 256)
    __store8(at + 1, code / 256)
    at = at + 2
  }
  __store8(at, 0)
  __store8(at + 1, 0)
  out
}

// 標準入力から 1 行読む。行末の改行は付けない
fn read_line() -> Int {
  let input = __os_GetStdHandle(0 - 10)
  let cell = __alloc(16)
  let mut out = str_new(64)
  let mut going = 1
  while going == 1 {
    __store(cell + 8, 0)
    let ok = __and(__os_ReadFile(input, cell, 1, cell + 8, 0), 4294967295)
    if ok == 0 || __load(cell + 8) == 0 {
      going = 0
    } else {
      let byte = __load8(cell)
      if byte == 10 {
        going = 0
      } else {
        out = str_push(out, byte)
      }
    }
  }
  __free(cell)
  let mut length = __load(out + 8)
  while length > 0 && __load8(out + 23 + length) == 13 {
    length = length - 1
  }
  __store(out + 8, length)
  out
}

// コマンドライン引数のリスト（プログラム名は含まない）。区切り方は Windows の標準の規則:
// 空白で区切る。"..." の中の空白は区切らない。\ は " の直前にあるときだけ特別で、
// 2 個で \ 1 個、残った 1 個は次の " を文字にする。"..." の中の "" は " 1 個
fn args_list() -> Int {
  let mut p = __os_GetCommandLineW()
  // プログラム名
  if wide_unit(p) == 34 {
    p = p + 2
    while wide_unit(p) != 0 && wide_unit(p) != 34 {
      p = p + 2
    }
    if wide_unit(p) == 34 {
      p = p + 2
    }
  } else {
    while wide_unit(p) != 0 && wide_unit(p) != 32 && wide_unit(p) != 9 {
      p = p + 2
    }
  }
  let mut out = list_new(4)
  let mut more = 1
  while more == 1 {
    while wide_unit(p) == 32 || wide_unit(p) == 9 {
      p = p + 2
    }
    if wide_unit(p) == 0 {
      more = 0
    } else {
      let mut arg = str_new(16)
      let mut quoted = 0
      let mut scanning = 1
      while scanning == 1 {
        let unit = wide_unit(p)
        if unit == 0 || (unit == 32 || unit == 9) && quoted == 0 {
          scanning = 0
        } else if unit == 92 {
          let mut slashes = 0
          while wide_unit(p) == 92 {
            slashes = slashes + 1
            p = p + 2
          }
          let mut keep = slashes
          if wide_unit(p) == 34 {
            keep = slashes / 2
          }
          while keep > 0 {
            arg = str_push(arg, 92)
            keep = keep - 1
          }
          if wide_unit(p) == 34 && slashes % 2 == 1 {
            arg = str_push(arg, 34)
            p = p + 2
          }
        } else if unit == 34 {
          if quoted == 1 && wide_unit(p + 2) == 34 {
            arg = str_push(arg, 34)
            p = p + 4
          } else {
            quoted = 1 - quoted
            p = p + 2
          }
        } else if unit >= 55296 && unit <= 56319 {
          arg = str_append_wide(arg, p, 2)
          p = p + 4
        } else {
          arg = str_push_code(arg, unit)
          p = p + 2
        }
      }
      out = list_push(out, arg)
    }
  }
  out
}

// address の 1 バイトが lowest〜highest に入っていれば 1（count の外なら 0）
fn byte_between(address: Int, at: Int, count: Int, lowest: Int, highest: Int) -> Int {
  if at >= count { return 0 }
  let byte = __load8(address + at)
  if byte >= lowest && byte <= highest { 1 } else { 0 }
}

// count バイトが正しい UTF-8 なら 1
fn utf8_valid(address: Int, count: Int) -> Int {
  let mut i = 0
  while i < count {
    let byte = __load8(address + i)
    let mut more = 0
    if byte < 128 {
      more = 0
    } else if byte >= 194 && byte <= 223 {
      more = 1
    } else if byte == 224 {
      if byte_between(address, i + 1, count, 160, 191) == 0 { return 0 }
      more = 2
    } else if byte == 237 {
      if byte_between(address, i + 1, count, 128, 159) == 0 { return 0 }
      more = 2
    } else if byte >= 225 && byte <= 239 {
      more = 2
    } else if byte == 240 {
      if byte_between(address, i + 1, count, 144, 191) == 0 { return 0 }
      more = 3
    } else if byte >= 241 && byte <= 243 {
      more = 3
    } else if byte == 244 {
      if byte_between(address, i + 1, count, 128, 143) == 0 { return 0 }
      more = 3
    } else {
      return 0
    }
    let mut k = 1
    while k <= more {
      if byte_between(address, i + k, count, 128, 191) == 0 { return 0 }
      k = k + 1
    }
    i = i + 1 + more
  }
  1
}

// ファイル操作のエラーの文面。kind: 0 = 読めない、1 = 中身が UTF-8 でない、2 = 書けない。
// code は OS のエラー番号（kind が 1 のときは使わない）
fn file_error(path: Int, kind: Int, code: Int) -> Int {
  let mut out = str_new(64)
  if kind == 2 {
    out = str_append_str(out, "cannot write `")
  } else {
    out = str_append_str(out, "cannot read `")
  }
  out = str_append_str(out, path)
  out = str_append_str(out, "`: ")
  if kind == 1 { return str_append_str(out, "stream did not contain valid UTF-8") }
  let buffer = __alloc(4096)
  // 4608 = システムの文面を使う + 差し込みは解釈しない
  let units = __and(__os_FormatMessageW(4608, 0, code, 0, buffer, 2040, 0), 4294967295)
  out = str_append_wide(out, buffer, units)
  __free(buffer)
  // 文面の末尾の改行と空白を除く
  let mut length = __load(out + 8)
  while length > 0 && is_space(__load8(out + 23 + length)) == 1 {
    length = length - 1
  }
  __store(out + 8, length)
  out = str_append_str(out, " (os error ")
  out = str_append_int(out, code)
  str_push(out, 41)
}

// 直前の OS のエラー番号
fn last_error() -> Int {
  __and(__os_GetLastError(), 4294967295)
}

// ファイルを読む。成功なら ok の番地に 1 を書いて中身を、失敗なら 0 を書いてエラーの文面を返す
fn file_read(path: Int, ok: Int) -> Int {
  __store(ok, 0)
  let wide = wide_copy(path)
  // 2147483648 = 読み取り、7 = ほかからの読み書き削除を許す、3 = あるファイルだけを開く
  let handle = __os_CreateFileW(wide, 2147483648, 7, 0, 3, 0, 0)
  let failed = last_error()
  __free(wide)
  if handle == 0 - 1 { return file_error(path, 0, failed) }
  let cell = __alloc(16)
  __store(cell, 0)
  let sized = __and(__os_GetFileSizeEx(handle, cell), 4294967295)
  let size = __load(cell)
  if sized == 0 {
    let code = last_error()
    __free(cell)
    let message = file_error(path, 0, code)
    let closed = __os_CloseHandle(handle)
    return message
  }
  let mut out = str_new(size)
  let mut done = 0
  let mut going = 1
  while going == 1 && done < size {
    __store(cell + 8, 0)
    let mut chunk = size - done
    if chunk > 1073741824 {
      chunk = 1073741824
    }
    let read = __and(__os_ReadFile(handle, out + 24 + done, chunk, cell + 8, 0), 4294967295)
    let got = __load(cell + 8)
    if read == 0 {
      let code = last_error()
      __free(cell)
      __free(out)
      let message = file_error(path, 0, code)
      let closed = __os_CloseHandle(handle)
      return message
    }
    if got == 0 {
      going = 0
    } else {
      done = done + got
    }
  }
  __free(cell)
  let closed = __os_CloseHandle(handle)
  __store(out + 8, done)
  if utf8_valid(out + 24, done) == 0 {
    __free(out)
    return file_error(path, 1, 0)
  }
  __store(ok, 1)
  out
}

// ファイルに書く（あれば上書き）。成功なら 0、失敗ならエラーの文面を返す
fn file_write(path: Int, content: Int) -> Int {
  let wide = wide_copy(path)
  // 1073741824 = 書き込み、2 = 常に新しく作る
  let handle = __os_CreateFileW(wide, 1073741824, 7, 0, 2, 0, 0)
  let failed = last_error()
  __free(wide)
  if handle == 0 - 1 { return file_error(path, 2, failed) }
  let cell = __alloc(16)
  let size = __load(content + 8)
  let mut done = 0
  while done < size {
    __store(cell, 0)
    let mut chunk = size - done
    if chunk > 1073741824 {
      chunk = 1073741824
    }
    let wrote = __and(__os_WriteFile(handle, content + 24 + done, chunk, cell, 0), 4294967295)
    if wrote == 0 {
      let code = last_error()
      __free(cell)
      let message = file_error(path, 2, code)
      let closed = __os_CloseHandle(handle)
      return message
    }
    done = done + __load(cell)
  }
  __free(cell)
  let closed = __os_CloseHandle(handle)
  0
}

// ここからウィンドウ、入力、時刻、乱数。`yui run` 側の同じ機能は src/window.rs にある。
// __global のマス: 0 = ウィンドウ、1 = 画素の置き場所、2 = 幅、3 = 高さ、4 = 1 画素の表示倍率、5 = 乱数の状態

fn zero_bytes(address: Int, bytes: Int) {
  let mut i = 0
  while i < bytes {
    __store(address + i, 0)
    i = i + 8
  }
}

// 色。赤・緑・青をそれぞれ 0〜255 に切り詰める
fn rgb(r: Int, g: Int, b: Int) -> Int {
  color_part(r) * 65536 + color_part(g) * 256 + color_part(b)
}

fn color_part(value: Int) -> Int {
  if value < 0 { 0 } else if value > 255 { 255 } else { value }
}

fn window_open(title: Int, width: Int, height: Int, scale: Int) {
  window_close()
  let mut w = width
  if w < 1 {
    w = 1
  }
  if w > 4096 {
    w = 4096
  }
  let mut h = height
  if h < 1 {
    h = 1
  }
  if h > 4096 {
    h = 4096
  }
  let mut size = scale
  if size < 1 {
    size = 1
  }
  if size > 64 {
    size = 64
  }
  let window = window_make(title, w * size, h * size)
  if window == 0 { return }
  let pixels = __alloc(w * h * 4)
  let mut i = 0
  while i < w * h {
    __store32(pixels + i * 4, 0)
    i = i + 1
  }
  __store(__global(0), window)
  __store(__global(1), pixels)
  __store(__global(2), w)
  __store(__global(3), h)
  __store(__global(4), size)
}

// 中身が 横 w × 縦 h（画面の点）のウィンドウを作る。作れなければ 0
fn window_make(title: Int, w: Int, h: Int) -> Int {
  let instance = __os_GetModuleHandleW(0)
  let class_name = wide_copy("YuiLangWindow")
  // ウィンドウの種類の登録。届いた出来事は OS の標準の処理にまかせる
  let class = __alloc(80)
  zero_bytes(class, 80)
  __store(class, 80)
  // 32 = 描く先をウィンドウが自分用に持ち続ける（GPU で描くときに要る）
  __store32(class + 4, 32)
  __store(class + 8, __import_DefWindowProcW())
  __store(class + 24, instance)
  __store(class + 40, __os_LoadCursorW(0, 32512))
  __store(class + 64, class_name)
  let registered = __os_RegisterClassExW(class)
  // 281673728 = タイトルバー・閉じるボタン・最小化ボタンつき、大きさは変えられない、表示する
  let style = 281673728
  // 中身が w * size × h * size になるような外枠の大きさ
  let rect = __alloc(16)
  __store32(rect, 0)
  __store32(rect + 4, 0)
  __store32(rect + 8, w)
  __store32(rect + 12, h)
  let adjusted = __os_AdjustWindowRect(rect, style, 0)
  let outer_width = __and(__load32(rect + 8) - __load32(rect), 4294967295)
  let outer_height = __and(__load32(rect + 12) - __load32(rect + 4), 4294967295)
  let wide_title = wide_copy(title)
  // 2147483648 = 場所は OS にまかせる
  let window = __os_CreateWindowExW(
    0,
    class_name,
    wide_title,
    style,
    2147483648,
    2147483648,
    outer_width,
    outer_height,
    0,
    0,
    instance,
    0,
  )
  __free(rect)
  __free(class)
  __free(wide_title)
  __free(class_name)
  window
}

fn window_forget() {
  let pixels = __load(__global(1))
  if pixels != 0 { __free(pixels) }
  let typed = __load(__global(16))
  if typed != 0 { __free(typed) }
  __store(__global(16), 0)
  gpu_fonts_forget()
  __store(__global(0), 0)
  __store(__global(1), 0)
  __store(__global(2), 0)
  __store(__global(3), 0)
  __store(__global(4), 0)
}

fn window_close() {
  let window = __load(__global(0))
  if window == 0 { return }
  let destroyed = __os_DestroyWindow(window)
  window_forget()
}

// ウィンドウに届いた出来事を処理して、画素を表示する。閉じられていたら 0
fn window_update() -> Int {
  let window = __load(__global(0))
  if window == 0 { return 0 }
  let message = __alloc(48)
  while __and(__os_PeekMessageW(message, 0, 0, 0, 1), 4294967295) != 0 {
    // 258 = 文字が打たれた
    if __load32(message + 8) == 258 {
      typed_add(__and(__load(message + 16), 65535))
    }
    let translated = __os_TranslateMessage(message)
    let dispatched = __os_DispatchMessageW(message)
  }
  __free(message)
  if __and(__os_IsWindow(window), 4294967295) == 0 {
    window_forget()
    return 0
  }
  // GPU で描くウィンドウなら、描きためた絵と表示中の絵を入れ替えるだけ
  if __load(__global(1)) == 0 {
    let swapped = __os_SwapBuffers(__load(__global(6)))
    return 1
  }
  let w = __load(__global(2))
  let h = __load(__global(3))
  let size = __load(__global(4))
  // 画素の並びの説明: 1 画素 32 ビット、高さを負にすると上の行が先頭
  let info = __alloc(48)
  zero_bytes(info, 48)
  __store32(info, 40)
  __store32(info + 4, w)
  __store32(info + 8, 4294967296 - h)
  __store32(info + 12, 2097153)
  let dc = __os_GetDC(window)
  // 13369376 = そのまま写す
  let drawn = __os_StretchDIBits(
    dc,
    0,
    0,
    w * size,
    h * size,
    0,
    0,
    w,
    h,
    __load(__global(1)),
    info,
    0,
    13369376,
  )
  let released = __os_ReleaseDC(window, dc)
  __free(info)
  1
}

// ---- 環境変数と、ネットワーク越しの依頼（HTTP / HTTPS） ----

// 環境変数の値。なければ空の文字列
fn env_get(name: Int) -> Int {
  let wide = wide_copy(name)
  let buffer = __alloc(65536)
  let units = __and(__os_GetEnvironmentVariableW(wide, buffer, 32767), 4294967295)
  __free(wide)
  let mut out = str_new(16)
  if units < 32767 {
    out = str_append_wide(out, buffer, units)
  }
  __free(buffer)
  out
}

// 依頼は裏で進む。OS は 1 段階終わるごとに、native.rs の小さな機械語（__http_callback）を別のスレッドから呼び、
// それが依頼ごとの置き場に「何が終わったか」を書き込む。http_done がそれを読んで次の段階を頼む。
// 同時に 8 件まで。置き場の番地は __global(8)〜__global(15) に入れる。
//
// 置き場（104 バイト）:
//   +0  終わった段階（OS が書く。読んだら 0 に戻す）   +8 その長さ   +16 待っているデータの量、または失敗の番号
//   +24 セッション  +32 接続  +40 依頼
//   +48 状態（0 = 進行中、4 = 終わった、5 = 失敗）
//   +56 送る本文の写し  +64 受け取った本文（文字列）  +72 HTTP の状態番号  +80 失敗の番号

fn http_slot(id: Int) -> Int {
  if id < 1 || id > 8 { return 0 }
  __global(8) + (id - 1) * 8
}

fn http_fail(st: Int, code: Int) {
  __store(st + 48, 5)
  __store(st + 80, code)
  http_close(st)
}

fn http_close(st: Int) {
  let request = __load(st + 40)
  if request != 0 {
    let closed = __os_WinHttpCloseHandle(request)
  }
  let connection = __load(st + 32)
  if connection != 0 {
    let closed = __os_WinHttpCloseHandle(connection)
  }
  let session = __load(st + 24)
  if session != 0 {
    let closed = __os_WinHttpCloseHandle(session)
  }
  let body = __load(st + 56)
  if body != 0 { __free(body) }
  __store(st + 24, 0)
  __store(st + 32, 0)
  __store(st + 40, 0)
  __store(st + 56, 0)
}

// 依頼を始めて、その番号（1〜8）を返す。同時に進められる数を超えていたら 0
fn http_start(method: Int, url: Int, headers: Int, body: Int) -> Int {
  let mut id = 1
  while id <= 8 && __load(http_slot(id)) != 0 {
    id = id + 1
  }
  if id > 8 { return 0 }
  let st = __alloc(104)
  zero_bytes(st, 104)
  __store(http_slot(id), st)
  // 行き先を、種類・相手の名前・ポート・道筋に分ける
  let wide_url = wide_copy(url)
  let parts = __alloc(104)
  zero_bytes(parts, 104)
  __store32(parts, 104)
  __store32(parts + 16, 4294967295)
  __store32(parts + 32, 4294967295)
  __store32(parts + 80, 4294967295)
  __store32(parts + 96, 4294967295)
  if __and(__os_WinHttpCrackUrl(wide_url, 0, 0, parts), 4294967295) == 0 {
    let code = last_error()
    __free(parts)
    __free(wide_url)
    http_fail(st, code)
    return id
  }
  let secure = __load32(parts + 20) == 2
  let host_units = __load32(parts + 32)
  let host = __alloc(host_units * 2 + 2)
  __copy(host, __load(parts + 24), host_units * 2)
  __store8(host + host_units * 2, 0)
  __store8(host + host_units * 2 + 1, 0)
  let port = __load8(parts + 36) + __load8(parts + 37) * 256
  // 道筋は行き先の文字列の残り全部。空なら OS にまかせる（"/" になる）
  let mut path = __load(parts + 72)
  if __load8(path) == 0 && __load8(path + 1) == 0 {
    path = 0
  }
  __free(parts)
  let agent = wide_copy("YuiLang")
  // 4 = システムに設定された中継を使う、268435456 = 裏で進める
  let session = __os_WinHttpOpen(agent, 4, 0, 0, 268435456)
  __free(agent)
  __store(st + 24, session)
  let mut failed = 0
  if session == 0 {
    failed = last_error()
  }
  if failed == 0 {
    // 8257536 = 段階が終わったときだけ知らせてもらう
    let watched = __os_WinHttpSetStatusCallback(session, __http_callback(), 8257536, 0)
    // 返事が始まるまで何分もかかることがある（言語モデルが考えている間）
    let timed = __os_WinHttpSetTimeouts(session, 0, 60000, 60000, 600000)
    let connection = __os_WinHttpConnect(session, host, port, 0)
    __store(st + 32, connection)
    if connection == 0 {
      failed = last_error()
    }
  }
  if failed == 0 {
    let verb = wide_copy(method)
    // 8388608 = 暗号化する
    let request = __os_WinHttpOpenRequest(__load(st + 32), verb, path, 0, 0, 0, if secure { 8388608 } else { 0 })
    if request == 0 {
      failed = last_error()
    }
    __free(verb)
    __store(st + 40, request)
  }
  if failed == 0 && __load(headers + 8) > 0 {
    let mut lines = str_new(256)
    let mut i = 0
    while i < __load(headers + 8) {
      if i > 0 {
        lines = str_push(lines, 13)
        lines = str_push(lines, 10)
      }
      lines = str_append_str(lines, __load(headers + 24 + i * 8))
      i = i + 1
    }
    let wide_lines = wide_copy(lines)
    __free(lines)
    // 536870912 = 見出しを足す
    if __and(__os_WinHttpAddRequestHeaders(__load(st + 40), wide_lines, 4294967295, 536870912), 4294967295) == 0 {
      failed = last_error()
    }
    __free(wide_lines)
  }
  if failed == 0 {
    // 本文は送り終わるまで動かせないので、写しを持っておく
    let size = __load(body + 8)
    let copy = __alloc(size + 8)
    __copy(copy, body + 24, size)
    __store(st + 56, copy)
    if __and(__os_WinHttpSendRequest(__load(st + 40), 0, 0, copy, size, size, st), 4294967295) == 0 {
      failed = last_error()
    }
  }
  __free(host)
  __free(wide_url)
  if failed != 0 {
    http_fail(st, failed)
  }
  id
}

// 依頼が終わったか。終わっていなければ、進められる分だけ進める
fn http_done(id: Int) -> Int {
  let slot = http_slot(id)
  if slot == 0 { return 1 }
  let st = __load(slot)
  if st == 0 { return 1 }
  while __load(st + 48) < 4 {
    let finished = __load(st)
    if finished == 0 { return 0 }
    let length = __and(__load(st + 8), 4294967295)
    let extra = __and(__load(st + 16), 4294967295)
    __store(st, 0)
    let request = __load(st + 40)
    if finished == 4194304 {
      // 送り終わった → 返事を待つ
      if __and(__os_WinHttpReceiveResponse(request, 0), 4294967295) == 0 {
        http_fail(st, last_error())
      }
    } else if finished == 131072 {
      // 返事の見出しが届いた → 状態番号を読み、本文を待つ
      let cell = __alloc(16)
      __store(cell, 0)
      __store(cell + 8, 4)
      // 536870931 = 状態番号を数として
      let asked = __os_WinHttpQueryHeaders(request, 536870931, 0, cell, cell + 8, 0)
      __store(st + 72, __load32(cell))
      __free(cell)
      __store(st + 64, str_new(4096))
      if __and(__os_WinHttpQueryDataAvailable(request, 0), 4294967295) == 0 {
        http_fail(st, last_error())
      }
    } else if finished == 262144 {
      // 本文が extra バイト待っている（0 なら終わり）
      if extra == 0 {
        __store(st + 48, 4)
        http_close(st)
      } else {
        let text = str_reserve(__load(st + 64), extra)
        __store(st + 64, text)
        if __and(__os_WinHttpReadData(request, text + 24 + __load(text + 8), extra, 0), 4294967295) == 0 {
          http_fail(st, last_error())
        }
      }
    } else if finished == 524288 {
      // length バイト読めた
      if length == 0 {
        __store(st + 48, 4)
        http_close(st)
      } else {
        let text = __load(st + 64)
        __store(text + 8, __load(text + 8) + length)
        if __and(__os_WinHttpQueryDataAvailable(request, 0), 4294967295) == 0 {
          http_fail(st, last_error())
        }
      }
    } else if finished == 2097152 {
      http_fail(st, extra)
    }
  }
  1
}

// 返ってきたものを 1 回だけ受け取る。本文なら ok に 1、失敗の説明なら 0 を入れる。
// 説明の文面は src/net.rs と同じにしてある
fn http_take(id: Int, ok: Int) -> Int {
  __store(ok, 0)
  let slot = http_slot(id)
  if slot == 0 { return str_append_str(str_new(32), "no such request") }
  let st = __load(slot)
  if st == 0 { return str_append_str(str_new(32), "no such request") }
  if http_done(id) == 0 { return str_append_str(str_new(32), "the request has not finished") }
  __store(slot, 0)
  let text = __load(st + 64)
  let state = __load(st + 48)
  let status = __load(st + 72)
  let code = __load(st + 80)
  __free(st)
  if state == 5 {
    if text != 0 { __free(text) }
    let mut out = str_append_str(str_new(48), "the request failed (os error ")
    out = str_append_int(out, code)
    return str_push(out, 41)
  }
  if utf8_valid(text + 24, __load(text + 8)) == 0 {
    __free(text)
    return str_append_str(str_new(40), "the response was not valid UTF-8")
  }
  if status >= 200 && status < 300 {
    __store(ok, 1)
    return text
  }
  let mut out = str_append_str(str_new(32 + __load(text + 8)), "HTTP ")
  out = str_append_int(out, status)
  out = str_append_str(out, ": ")
  out = str_append_str(out, text)
  __free(text)
  out
}

// ---- GPU（OpenGL の古い方式）で描く ----
//
// 小数は 64 ビットの並びのまま受け取り、そのまま OS の関数に渡す
// （小数を受け取る関数は native.rs の FLOAT_CALLS にあり、呼ぶ直前に小数用の置き場へ写される）。
// このファイルでは小数の計算ができないので、必要な小数は整数から並びを組み立てる。
//
// __global(6) = 描く先、__global(7) = OpenGL の文脈（どちらも GPU のウィンドウを開いたときだけ）

// 正の整数 n（2 の 53 乗未満）を表す小数（64 ビット）の並び
fn float_bits(n: Int) -> Int {
  if n <= 0 { return 0 }
  let mut p = 0
  while __shr(n, p + 1) != 0 {
    p = p + 1
  }
  (1023 + p) * 4503599627370496 + __and(__shl(n, 52 - p), 4503599627370495)
}

// 小数の並びの符号を逆にする
fn float_flip(bits: Int) -> Int {
  __xor(bits, __shl(1, 63))
}

// 色の部分 c（0〜255）を 255 で割った小数（32 ビット）の並び
fn float32_part(c: Int) -> Int {
  if c <= 0 { return 0 }
  if c >= 255 { return 1065353216 }
  let mut k = 0
  while __shl(c, k) < 255 {
    k = k + 1
  }
  (127 - k) * 8388608 + __shl(c, k + 23) / 255 - 8388608
}

fn gpu_ready() -> Int {
  if __load(__global(0)) != 0 && __load(__global(1)) == 0 && __load(__global(7)) != 0 { 1 } else { 0 }
}

fn gpu_open(title: Int, width: Int, height: Int) {
  window_close()
  // 前の GPU のウィンドウの文脈が残っていれば片づける
  let old = __load(__global(7))
  if old != 0 {
    let released = __os_wglMakeCurrent(0, 0)
    let deleted = __os_wglDeleteContext(old)
    __store(__global(7), 0)
  }
  let mut w = width
  if w < 1 {
    w = 1
  }
  if w > 4096 {
    w = 4096
  }
  let mut h = height
  if h < 1 {
    h = 1
  }
  if h > 4096 {
    h = 4096
  }
  // 画面の点 1 つを絵の点 1 つにする（OS に引き伸ばさせない）
  let aware = __os_SetProcessDPIAware()
  let window = window_make(title, w, h)
  if window == 0 { return }
  let dc = __os_GetDC(window)
  // 描く先の種類: ウィンドウに、OpenGL で、1 枚描き終えてから見せる。色 32 ビット、奥行き 24 ビット
  let format = __alloc(40)
  zero_bytes(format, 40)
  __store32(format, 65576)
  __store32(format + 4, 37)
  __store8(format + 9, 32)
  __store8(format + 23, 24)
  let index = __and(__os_ChoosePixelFormat(dc, format), 4294967295)
  let chosen = __os_SetPixelFormat(dc, index, format)
  __free(format)
  let context = __os_wglCreateContext(dc)
  if context == 0 || __and(__os_wglMakeCurrent(dc, context), 4294967295) == 0 {
    let destroyed = __os_DestroyWindow(window)
    return
  }
  __store(__global(0), window)
  __store(__global(1), 0)
  __store(__global(2), w)
  __store(__global(3), h)
  __store(__global(4), 1)
  __store(__global(6), dc)
  __store(__global(7), context)
  let port = __os_glViewport(0, 0, w, h)
  // 2929 = 手前のものが奥のものを隠す
  let depth = __os_glEnable(2929)
  // 見える範囲: 上下 70 度、0.1 〜 1000 先まで。整数だけで決めてから全体を縮める
  let near = h * 10 / 7
  let unit = float_bits(near * 10)
  let fw = float_bits(w)
  let fh = float_bits(h)
  let a = __os_glMatrixMode(5889)
  let b = __os_glLoadIdentity()
  let c = __os_glFrustum(float_flip(fw), fw, float_flip(fh), fh, float_bits(near), float_bits(near * 10000))
  let d = __os_glScaled(unit, unit, unit)
  let e = __os_glMatrixMode(5888)
  let f = __os_glLoadIdentity()
}

fn gpu_clear(color: Int) {
  if gpu_ready() == 0 { return }
  let r = float32_part(__and(__shr(color, 16), 255))
  let g = float32_part(__and(__shr(color, 8), 255))
  let b = float32_part(__and(color, 255))
  let set = __os_glClearColor(r, g, b, 0)
  // 16640 = 色と奥行きの両方
  let cleared = __os_glClear(16640)
}

// (x, y, z) から見る。turn・tilt は度。小数はどれも 64 ビットの並び
fn gpu_camera(x: Int, y: Int, z: Int, turn: Int, tilt: Int) {
  if gpu_ready() == 0 { return }
  let one = float_bits(1)
  let a = __os_glMatrixMode(5888)
  let b = __os_glLoadIdentity()
  let c = __os_glScaled(one, one, float_flip(one))
  let d = __os_glRotated(tilt, one, 0, 0)
  let e = __os_glRotated(float_flip(turn), 0, one, 0)
  let f = __os_glTranslated(float_flip(x), float_flip(y), float_flip(z))
}

fn gpu_fog(color: Int, start: Int, end: Int) {
  if gpu_ready() == 0 { return }
  if end <= start {
    let disabled = __os_glDisable(2912)
    return
  }
  let mut lo = start
  if lo < 0 {
    lo = 0
  }
  if lo > 1048576 {
    lo = 1048576
  }
  let mut hi = end
  if hi > 1048576 {
    hi = 1048576
  }
  let enabled = __os_glEnable(2912)
  // 2917 = 霧のかかり方、9729 = 距離に比例
  let kind = __os_glFogi(2917, 9729)
  let a = __os_glFogi(2915, lo)
  let b = __os_glFogi(2916, hi)
  let parts = __alloc(16)
  __store32(parts, float32_part(__and(__shr(color, 16), 255)))
  __store32(parts + 4, float32_part(__and(__shr(color, 8), 255)))
  __store32(parts + 8, float32_part(__and(color, 255)))
  __store32(parts + 12, 0)
  let c = __os_glFogfv(2918, parts)
  __free(parts)
}

// 三角形の集まりを GPU に覚えさせ、その番号を返す。
// points は小数のリスト（三角形 1 つにつき 9 個）、colors は色のリスト（三角形 1 つにつき 1 個）
fn gpu_mesh(points: Int, colors: Int) -> Int {
  if gpu_ready() == 0 { return 0 }
  let mut count = __load(points + 8) / 9
  if __load(colors + 8) < count {
    count = __load(colors + 8)
  }
  let list = __and(__os_glGenLists(1), 4294967295)
  if list == 0 { return 0 }
  // 4864 = 覚えるだけで、まだ描かない。4 = 三角形
  let opened = __os_glNewList(list, 4864)
  let began = __os_glBegin(4)
  let mut i = 0
  while i < count {
    let color = __load(colors + 24 + i * 8)
    let colored = __os_glColor3ub(__and(__shr(color, 16), 255), __and(__shr(color, 8), 255), __and(color, 255))
    let corner = points + 24 + i * 72
    let a = __os_glVertex3dv(corner)
    let b = __os_glVertex3dv(corner + 24)
    let c = __os_glVertex3dv(corner + 48)
    i = i + 1
  }
  let ended = __os_glEnd()
  let closed = __os_glEndList()
  list
}

fn gpu_draw(mesh: Int, x: Int, y: Int, z: Int) {
  if gpu_ready() == 0 || mesh <= 0 { return }
  let a = __os_glPushMatrix()
  let b = __os_glTranslated(x, y, z)
  let c = __os_glCallList(mesh)
  let d = __os_glPopMatrix()
}

fn gpu_free(mesh: Int) {
  if gpu_ready() == 0 || mesh <= 0 { return }
  let deleted = __os_glDeleteLists(mesh, 1)
}

fn gpu_limit(n: Int) -> Int {
  if n < 0 - 1048576 { 0 - 1048576 } else if n > 1048576 { 1048576 } else { n }
}

// 絵の上に重ねる長方形。左上からの点の数で場所を決める
fn gpu_rect(x: Int, y: Int, width: Int, height: Int, color: Int) {
  if gpu_ready() == 0 { return }
  let left = gpu_limit(x)
  let top = gpu_limit(y)
  let right = left + gpu_limit(width)
  let bottom = top + gpu_limit(height)
  gpu_overlay_begin()
  let j = __os_glColor3ub(__and(__shr(color, 16), 255), __and(__shr(color, 8), 255), __and(color, 255))
  // 7 = 四角形
  let k = __os_glBegin(7)
  let l = __os_glVertex2i(left, top)
  let m = __os_glVertex2i(right, top)
  let n = __os_glVertex2i(right, bottom)
  let o = __os_glVertex2i(left, bottom)
  let p = __os_glEnd()
  gpu_overlay_end()
}

// 絵の上に平らに重ねて描く準備（左上からの点の数で場所を決められるようにする）と、その片づけ
fn gpu_overlay_begin() {
  let one = float_bits(1)
  // 8192 = 入・切の設定を覚えておく
  let saved = __os_glPushAttrib(8192)
  let a = __os_glDisable(2929)
  let b = __os_glDisable(2912)
  let c = __os_glMatrixMode(5889)
  let d = __os_glPushMatrix()
  let e = __os_glLoadIdentity()
  let f = __os_glOrtho(0, float_bits(__load(__global(2))), float_bits(__load(__global(3))), 0, float_flip(one), one)
  let g = __os_glMatrixMode(5888)
  let h = __os_glPushMatrix()
  let i = __os_glLoadIdentity()
}

fn gpu_overlay_end() {
  let q = __os_glPopMatrix()
  let r = __os_glMatrixMode(5889)
  let s = __os_glPopMatrix()
  let t = __os_glMatrixMode(5888)
  let u = __os_glPopAttrib()
}

// 文字。大きさごとに、文字 1 つずつの絵を GPU に覚えさせておく（初めて使う文字だけ、その場で作る）。
// 大きさは 4 種類まで覚える。表の番地は __global(17)、1 種類 48 バイト:
//   +0 大きさ  +8 書体  +16 絵の番号の先頭（文字コードを足す）  +24 作った文字の印（65,536 バイト）
//   +32 文字の上端から基準の線まで  +40 行の高さ
fn gpu_fonts_forget() {
  let table = __load(__global(17))
  if table == 0 { return }
  let mut i = 0
  while i < 4 {
    let entry = table + i * 48
    if __load(entry) != 0 {
      let deleted = __os_DeleteObject(__load(entry + 8))
      __free(__load(entry + 24))
    }
    i = i + 1
  }
  __free(table)
  __store(__global(17), 0)
}

fn gpu_font(size: Int) -> Int {
  let mut table = __load(__global(17))
  if table == 0 {
    table = __alloc(192)
    zero_bytes(table, 192)
    __store(__global(17), table)
  }
  let mut i = 0
  while i < 4 && __load(table + i * 48) != 0 {
    if __load(table + i * 48) == size { return table + i * 48 }
    i = i + 1
  }
  let mut entry = table + i * 48
  if i == 4 {
    // 5 種類目は、最初の 1 種類と入れ替える
    entry = table
    let deleted = __os_glDeleteLists(__load(entry + 16), 65536)
    let dropped = __os_DeleteObject(__load(entry + 8))
    __free(__load(entry + 24))
  }
  let dc = __load(__global(6))
  let face = wide_copy("Yu Gothic UI")
  let font = __os_CreateFontW(0 - size, 0, 0, 0, 400, 0, 0, 0, 1, 0, 0, 0, 0, face)
  __free(face)
  let old = __os_SelectObject(dc, font)
  let metrics = __alloc(64)
  zero_bytes(metrics, 64)
  let measured = __os_GetTextMetricsW(dc, metrics)
  let flags = __alloc(65536)
  zero_bytes(flags, 65536)
  __store(entry, size)
  __store(entry + 8, font)
  __store(entry + 16, __and(__os_glGenLists(65536), 4294967295))
  __store(entry + 24, flags)
  __store(entry + 32, __load32(metrics + 4))
  __store(entry + 40, __load32(metrics))
  __free(metrics)
  entry
}

// 絵の上に重ねる文字。左上が (x, y)、文字の高さが size 点。改行で次の行へ進む
fn gpu_text(x: Int, y: Int, size: Int, color: Int, text: Int) {
  if gpu_ready() == 0 { return }
  let mut height = size
  if height < 6 {
    height = 6
  }
  if height > 200 {
    height = 200
  }
  let entry = gpu_font(height)
  let base = __load(entry + 16)
  if base == 0 { return }
  let flags = __load(entry + 24)
  let dc = __load(__global(6))
  let left = gpu_limit(x)
  let mut line = gpu_limit(y) + __load(entry + 32)
  gpu_overlay_begin()
  let colored = __os_glColor3ub(__and(__shr(color, 16), 255), __and(__shr(color, 8), 255), __and(color, 255))
  let placed = __os_glRasterPos2i(left, line)
  let count = __load(text + 8)
  let mut selected = 0
  let mut i = 0
  while i < count {
    let code = utf8_code(text + 24 + i)
    i = i + utf8_width(__load8(text + 24 + i))
    if code == 10 {
      line = line + __load(entry + 40)
      let moved = __os_glRasterPos2i(left, line)
    } else if code >= 32 && code < 65536 {
      if __load8(flags + code) == 0 {
        if selected == 0 {
          let old = __os_SelectObject(dc, __load(entry + 8))
          selected = 1
        }
        // 最初の 1 回は失敗することがあるので、失敗したらもう一度頼む
        if __and(__os_wglUseFontBitmapsW(dc, code, 1, base + code), 4294967295) == 0 {
          let again = __os_wglUseFontBitmapsW(dc, code, 1, base + code)
        }
        __store8(flags + code, 1)
      }
      let drawn = __os_glCallList(base + code)
    }
  }
  gpu_overlay_end()
}

// 打たれた文字をためておく場所: [個数][16 ビットの単位が 256 個まで]。番地は __global(16)
fn typed_add(unit: Int) {
  let mut typed = __load(__global(16))
  if typed == 0 {
    typed = __alloc(8 + 512)
    __store(typed, 0)
    __store(__global(16), typed)
  }
  let count = __load(typed)
  if count >= 256 { return }
  // Enter は改行にする
  let kept = if unit == 13 { 10 } else { unit }
  __store8(typed + 8 + count * 2, kept % 256)
  __store8(typed + 9 + count * 2, kept / 256)
  __store(typed, count + 1)
}

// 前に呼んでから打たれた文字
fn text_input() -> Int {
  let typed = __load(__global(16))
  let mut out = str_new(16)
  if typed == 0 { return out }
  out = str_append_wide(out, typed + 8, __load(typed))
  __store(typed, 0)
  out
}

fn draw_clear(color: Int) {
  let pixels = __load(__global(1))
  if pixels == 0 { return }
  let count = __load(__global(2)) * __load(__global(3))
  let mut i = 0
  while i < count {
    __store32(pixels + i * 4, color)
    i = i + 1
  }
}

// 範囲の外は何もしない
fn draw_pixel(x: Int, y: Int, color: Int) {
  let pixels = __load(__global(1))
  if pixels == 0 { return }
  let w = __load(__global(2))
  if x < 0 || y < 0 || x >= w || y >= __load(__global(3)) { return }
  __store32(pixels + (y * w + x) * 4, color)
}

// 長方形のうち、ウィンドウに入る部分を塗る
fn draw_rect(x: Int, y: Int, width: Int, height: Int, color: Int) {
  let pixels = __load(__global(1))
  if pixels == 0 { return }
  let w = __load(__global(2))
  let h = __load(__global(3))
  let mut left = x
  if left < 0 {
    left = 0
  }
  let mut top = y
  if top < 0 {
    top = 0
  }
  let mut right = x + width
  if right > w {
    right = w
  }
  let mut bottom = y + height
  if bottom > h {
    bottom = h
  }
  let mut row = top
  while row < bottom {
    let mut at = pixels + (row * w + left) * 4
    let end = pixels + (row * w + right) * 4
    while at < end {
      __store32(at, color)
      at = at + 4
    }
    row = row + 1
  }
}

// キーの名前から OS のキーの番号。知らない名前は 0
fn key_code(name: Int) -> Int {
  if __load(name + 8) == 1 {
    let byte = __load8(name + 24)
    if byte >= 97 && byte <= 122 { return byte - 32 }
    if byte >= 65 && byte <= 90 || byte >= 48 && byte <= 57 || byte == 32 { return byte }
    return 0
  }
  if str_eq(name, "left") == 1 { return 37 }
  if str_eq(name, "up") == 1 { return 38 }
  if str_eq(name, "right") == 1 { return 39 }
  if str_eq(name, "down") == 1 { return 40 }
  if str_eq(name, "space") == 1 { return 32 }
  if str_eq(name, "enter") == 1 { return 13 }
  if str_eq(name, "escape") == 1 { return 27 }
  if str_eq(name, "shift") == 1 { return 16 }
  if str_eq(name, "ctrl") == 1 { return 17 }
  if str_eq(name, "tab") == 1 { return 9 }
  0
}

// このウィンドウが手前にあって操作を受けているか
fn window_focused() -> Int {
  let window = __load(__global(0))
  if window != 0 && __os_GetForegroundWindow() == window { 1 } else { 0 }
}

fn key_down(name: Int) -> Int {
  let code = key_code(name)
  if code == 0 || window_focused() == 0 { return 0 }
  if __and(__os_GetAsyncKeyState(code), 32768) != 0 { 1 } else { 0 }
}

// 0 = 左ボタン、1 = 右ボタン、2 = 中ボタン
fn mouse_down(button: Int) -> Int {
  let mut code = 0
  if button == 0 {
    code = 1
  } else if button == 1 {
    code = 2
  } else if button == 2 {
    code = 4
  }
  if code == 0 || window_focused() == 0 { return 0 }
  if __and(__os_GetAsyncKeyState(code), 32768) != 0 { 1 } else { 0 }
}

// マウスの位置（ウィンドウの中での点の数。axis: 0 = 横、1 = 縦）。表示倍率で割るのは呼び出し側
fn mouse_raw(axis: Int) -> Int {
  let window = __load(__global(0))
  if window == 0 { return 0 }
  let point = __alloc(8)
  let found = __os_GetCursorPos(point)
  let moved = __os_ScreenToClient(window, point)
  let mut value = __load32(point + axis * 4)
  __free(point)
  if value >= 2147483648 {
    value = value - 4294967296
  }
  value
}

fn time_ms() -> Int {
  __os_GetTickCount64()
}

// 指定した時間だけ待つ。OS の Sleep は 16 ミリ秒を頼んでも 30 ミリ秒ほど待つことがあるので、
// 精度の高いタイマーを使う（古い Windows で作れなければ Sleep にする）
fn sleep_ms(ms: Int) {
  if ms <= 0 { return }
  // 2 = 精度の高いタイマー、2031619 = すべての操作を許す
  let timer = __os_CreateWaitableTimerExW(0, 0, 2, 2031619)
  if timer == 0 {
    let slept = __os_Sleep(ms)
    return
  }
  // 待つ長さは 100 ナノ秒単位で、負の数にすると「今から」の意味になる
  let due = __alloc(8)
  __store(due, 0 - ms * 10000)
  let set = __os_SetWaitableTimer(timer, due, 0, 0, 0, 0)
  // 4294967295 = 終わるまで待つ
  let waited = __os_WaitForSingleObject(timer, 4294967295)
  __free(due)
  let closed = __os_CloseHandle(timer)
}

// 乱数の種を決める。同じ種なら同じ並びになる（src/window.rs と同じ計算）
fn random_seed(seed: Int) {
  let mut state = __xor(seed, 88172645463325252)
  if state == 0 {
    state = 88172645463325252
  }
  __store(__global(5), state)
}

// 次の乱数（0 以上）。範囲に収めるのは呼び出し側
fn random_next() -> Int {
  let mut x = __load(__global(5))
  if x == 0 {
    let cell = __alloc(8)
    let counted = __os_QueryPerformanceCounter(cell)
    x = __xor(__load(cell), 88172645463325252)
    __free(cell)
    if x == 0 {
      x = 88172645463325252
    }
  }
  x = __xor(x, __shr(x, 12))
  x = __xor(x, __shl(x, 25))
  x = __xor(x, __shr(x, 27))
  __store(__global(5), x)
  __shr(x * 2685821657736338717, 1)
}
