// 契約、引数の多い関数、Int のメソッド、値の表示と ==、first / last

struct Point {
  x: Int,
  y: Int,
}

struct Shelf {
  name: String,
  items: List<String>,
  at: Point,
  tag: Option<Int>,
}

enum Shape {
  Circle(Int),
  Rect(Int, Int),
  Named(String, Point),
  Empty,
}

enum Color {
  Red,
  Green,
}

fn checked_half(n: Int) -> Int
  requires n % 2 == 0
  ensures result * 2 == n
{
  n / 2
}

fn clamp(x: Int, lo: Int, hi: Int) -> Int
  requires lo <= hi
  ensures result >= lo && result <= hi
{
  x.max(lo).min(hi)
}

fn label(p: Point) -> String
  requires p.x >= 0
  ensures result.len() > 0
{
  "({p.x}, {p.y})"
}

fn deep(a: Int, b: Int, c: Int, d: Int, e: Int, f: Int, g: Int, h: Int) -> Int {
  a + (b + (c + (d + (e + (f + (g + (h + 1)))))))
}

fn weighted(a: Int, b: Int, c: Int, d: Int, e: Int, name: String, p: Point) -> String {
  "{name}: {a * 1 + b * 2 + c * 3 + d * 4 + e * 5 + p.x - p.y}"
}

fn sum6(a: Int, b: Int, c: Int, d: Int, e: Int, f: Int) -> Int {
  if a == 0 { b + c + d + e + f } else { sum6(a - 1, b + 1, c, d, e, f + a) }
}

fn ends(xs: List<Int>) -> Int {
  let a = xs.first().unwrap_or(-1)
  let b = xs.last().unwrap_or(-2)
  a * 100 + b
}

fn main() uses io {
  print("{checked_half(10)} {clamp(5, 0, 3)} {clamp(-5, 0, 3)} {clamp(2, 0, 3)} {label(Point { x: 1, y: 2 })}")
  print("{deep(1, 2, 3, 4, 5, 6, 7, 8)} {sum6(3, 1, 2, 3, 4, 5)} {deep(deep(1, 1, 1, 1, 1, 1, 1, 1), 2, sum6(0, 1, 1, 1, 1, 1), 4, 5, 6, 7, 8)}")
  let name = "w"
  print(weighted(1, 2, 3, 4, 5, name, Point { x: 10, y: 4 }))

  // Int のメソッド
  let big = 9223372036854775807
  print("{(0 - 5).abs()} {5.abs()} {0.abs()} {(0 - big).abs()} {3.min(7)} {3.max(7)} {(0 - 3).min(0 - 7)} {big.max(1)}")
  print("{12.bit_and(10)} {12.bit_or(10)} {12.bit_xor(10)} {1.shl(10)} {1024.shr(3)} {(0 - 16).shr(2)} {1.shl(63)} {5.shl(0)} {(0 - 1).bit_and(255)}")

  // 値の表示
  let p = Point { x: 3, y: -4 }
  let xs = [1, 2, 3]
  let words = ["a", "b c", "quote\"d", "tab\tnew\nline\\"]
  let empty: List<Int> = []
  print("{p} {xs} {empty} {words}")
  print("{xs}")
  print("{p}")
  let shelf = Shelf { name: "top", items: ["x", "y"], at: p, tag: Some(7) }
  print("{shelf}")
  let bare = Shelf { name: "", items: [], at: Point { x: 0, y: 0 }, tag: None }
  print("{bare} {shelf.tag} {bare.tag} {shelf.items}")
  let shapes = [Shape.Circle(2), Shape.Rect(3, 4), Shape.Named("n", p), Shape.Empty]
  print("{shapes}")
  print("{Color.Red} {Color.Green} {[Color.Green, Color.Red]} {Shape.Empty} {shapes[0]}")
  let results: List<Result<Int, String>> = [Ok(1), Err("bad")]
  print("{results} {[Some(xs), None]} {[[1], [], [2, 3]]} {[true, false]}")
  print("{p.to_string()} {xs.to_string().len()} {shapes[1].to_string()}")

  // 等しいかどうか
  let q = Point { x: 3, y: -4 }
  print("{p == q} {p != q} {p == Point { x: 3, y: 4 }} {xs == [1, 2, 3]} {xs == [1, 2]} {xs != [1, 2, 4]} {empty == []}")
  let same_words = ["a", "b c", "quote\"d", "tab\tnew\nline\\"]
  print("{shelf == shelf} {shelf == bare} {words == same_words} {words == shelf.items} {shapes[0] == Shape.Circle(2)} {shapes[0] == Shape.Circle(3)}")
  let named = Shape.Named("n", q)
  print("{shapes[3] == Shape.Empty} {shapes[2] == named} {shapes[2] == Shape.Empty} {Color.Red == Color.Red} {Color.Red != Color.Green}")
  let bad: Result<Int, String> = Err("bad")
  print("{results[0] == Ok(1)} {results[1] == bad} {results[0] == results[1]} {shelf.tag == Some(7)} {bare.tag == None} {shelf.tag == bare.tag}")
  print("{[[1], [2]] == [[1], [2]]} {[[1], [2]] == [[1], [3]]} {[p, q] == [q, p]}")

  print("{ends([4, 5, 6])} {ends([9])} {ends([])} {words.first().unwrap_or(name)} {words.last().unwrap_or(name).len()}")
}
