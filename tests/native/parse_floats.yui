// 文字列から小数への変換と、小数のリストの並べ替え

fn show(text: String) uses io {
  match text.to_float() {
    Some(value) => print("[{text}] -> {value}")
    None => print("[{text}] -> none")
  }
}

fn main() uses io {
  // ふつうの数
  for text in ["0", "1", "-1", "3.14", "  2.5  ", "+7.25", "100", "0.1", "0.2", "0.30000000000000004", "1.", ".5", "-.5", "-0.0", "007.50"] {
    show(text)
  }
  // 指数
  for text in ["1e3", "1E3", "2.5e-3", "1e+2", "1e22", "1e23", "9007199254740993", "9007199254740992.5", "123456789012345678901234567890", "4.9e-324", "2.5e-324", "2.4e-324", "1e-400", "1.7976931348623157e308", "1.7976931348623159e308", "1e309", "5e-324", "2.2250738585072014e-308", "2.2250738585072011e-308"] {
    show(text)
  }
  // 丸めの境目（ちょうど真ん中と、その前後）
  for text in ["1.00000000000000011102230246251565404236316680908203125", "1.00000000000000011102230246251565404236316680908203124", "1.00000000000000011102230246251565404236316680908203126", "0.500000000000000166533453693773481063544750213623046875", "8.98846567431158e307", ".9999999999"] {
    show(text)
  }
  // 特別な値
  for text in ["inf", "-inf", "+Infinity", "INF", "nan", "NaN", "-nan", "infinit", "nann"] {
    show(text)
  }
  // 読めない形
  for text in ["", " ", ".", "e5", "1e", "1e+", "1.2.3", "1,5", "0x10", "1_000", "１２", "--1", "1 2", "abc", "1e5x"] {
    show(text)
  }

  // 並べ替え: -0.0 は 0.0 の前
  let xs = [3.5, -1.25, 0.0, 100.0, -0.0, 2.0, -1000.5, 0.001, 2.0]
  print("{xs.sort()}")
  let none: List<Float> = []
  print("{none.sort()} {[1.5].sort()}")
  let parsed = ["2.5", "x", "-1", "1e2"].map(|t| t.to_float().unwrap_or(0.0))
  print("{parsed.sort()}")
}
