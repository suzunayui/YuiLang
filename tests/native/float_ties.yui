fn main() uses io {
  // 表示の桁を決めるときに、ちょうど真ん中になる数
  let mut x = 106780879977543.125
  for i in 0..40 {
    print("{x} {x / 3.0} {x * 1.0000001}")
    x = x * 1.5 + 0.015625
  }
  let mut y = 0.5
  for i in 0..60 {
    print("{y} {y + 0.25} {y * 3.0} {1.0 / y}")
    y = y * 2.5
  }
  let mut z = 9007199254740993.0
  for i in 0..30 {
    print("{z} {z + 2.0} {z / 7.0}")
    z = z * 4.0 + 2.0
  }
}
