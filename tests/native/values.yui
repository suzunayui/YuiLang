// 機械語への変換（yui build --native）と yui run の出力が一致することを確かめるためのプログラム

fn fib(n: Int) -> Int {
  if n < 2 { n } else { fib(n - 1) + fib(n - 2) }
}

fn gcd(a: Int, b: Int) -> Int {
  let mut x = a
  let mut y = b
  while y != 0 {
    let t = x % y
    x = y
    y = t
  }
  x
}

fn ack(m: Int, n: Int) -> Int {
  if m == 0 { n + 1 } else if n == 0 { ack(m - 1, 1) } else { ack(m - 1, ack(m, n - 1)) }
}

fn four(a: Int, b: Int, c: Int, d: Int) -> Int {
  a * 1000 + b * 100 + c * 10 + d
}

fn is_even(n: Int) -> Bool {
  n % 2 == 0
}

fn many(x: Int) -> Int {
  let a = x + 1
  let b = a + 1
  let c = b + 1
  let d = c + 1
  let e = d + 1
  let f = e + 1
  let g = f + 1
  let h = g + 1
  let i = h + 1
  let j = i + 1
  a + b + c + d + e + f + g + h + i + j
}

fn sign(n: Int) -> Int {
  if n < 0 { return 0 - 1 }
  if n == 0 { return 0 }
  1
}

fn count(limit: Int) -> Int {
  let mut total = 0
  for i in 0..limit {
    if i % 3 == 0 { continue }
    if i > 20 { break }
    total = total + i
  }
  total
}

fn divide(a: Int, b: Int) -> Int {
  a / b
}

fn remainder(a: Int, b: Int) -> Int {
  a % b
}

fn main() uses io {
  print("fib {fib(20)}")
  print("gcd {gcd(1071, 462)}")
  print("ack {ack(2, 3)}")
  print("four {four(1, 2, 3, 4)} {four(fib(5), gcd(8, 12), 7 - 2 * 3, 9 % 5)}")
  print("even {is_even(10)} {is_even(7)} {!is_even(7)}")
  print("many {many(1)}")
  print("sign {sign(0 - 5)} {sign(0)} {sign(9)}")
  print("div {7 / 2} {(0 - 7) / 2} {7 % 3} {(0 - 7) % 3}")
  print("div by variable {divide(7, 0 - 2)} {remainder(0 - 7, 3)} {divide(0 - 9, 0 - 1)} {remainder(9, 0 - 1)}")
  let big = 9223372036854775807
  print("big {big} {0 - big} {0 - big - 1} {big / 1000000007} {big % 1000000007}")
  let x = 5
  let y = 7
  print("logic {x < y && y < 10} {x > y || x == 5} {x >= 5} {x != 5} {!(x < y)}")
  print("deep {1 + (2 + (3 + (4 + (5 + (6 + (7 + (8 + x)))))))}")
  print("mixed {(x + y) * (x - y) + fib(x) * (y - fib(3))}")
  let mut total = 0
  for i in 0..10 {
    total = total + i * i
  }
  print("squares {total}")
  print("count {count(100)}")
  let z = if x > 3 { x * 2 } else { y }
  print("if {z} {if y > 100 { 1 } else { 2 }}")
  let mut a = 10
  let b = 3
  a = b - a
  print("assign {a}")
  a = a * a + a
  print("assign {a}")
  let nested = {
    let t = x * 2
    t + 1
  }
  print("block {nested}")
  let flag = x < y
  let mut seen = false
  seen = seen || flag
  print("flags {flag} {seen} {flag && !seen}")
  print("")
  print("done")
}
