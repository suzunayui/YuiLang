    model_text("box", beam, 8.3, 2.3, 2.04, 1.4, 0.1, 0.3, 0.0),
    // 屋根と煙突
    model_text("roof", "#c0392b", 6.0, 3.2, 5.0, 9.2, 2.6, 7.2, 0.0),
    model_text("box", "#7a5548", 8.4, 3.6, 6.2, 0.7, 2.6, 0.7, 0.0),
    model_text("box", stone, 8.4, 6.2, 6.2, 0.9, 0.15, 0.9, 0.0),
    // 丸い塔と、とんがり屋根、てっぺんの玉
    model_text("cylinder", "#d9d2c4", 11.3, 0.0, 7.0, 2.6, 5.6, 2.6, 0.0),
    model_text("cylinder", stone, 11.3, 5.6, 7.0, 3.0, 0.25, 3.0, 0.0),
    model_text("cone", "#3a5496", 11.3, 5.85, 7.0, 3.4, 3.0, 3.4, 0.0),
    model_text("sphere", "#f0c43c", 11.3, 8.75, 7.0, 0.4, 0.4, 0.4, 0.0),
    // 戸口の段、街灯、植え込み、斜めに置いたベンチ
    model_text("wedge", stone, 6.0, 0.0, 1.5, 1.6, 0.4, 1.0, 0.0),
