    // 壁（正面は入口の分を空ける）
    model_text("box", wall, 6.0, 0.4, 7.9, 8.0, 2.8, 0.2, 0.0),
    model_text("box", wall, 2.1, 0.4, 5.0, 0.2, 2.8, 6.0, 0.0),
    model_text("box", wall, 9.9, 0.4, 5.0, 0.2, 2.8, 6.0, 0.0),
