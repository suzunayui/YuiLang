    model_text("box", wall, 8.3, 0.4, 2.1, 3.4, 2.8, 0.2, 0.0),
    model_text("box", wall, 6.0, 2.6, 2.1, 1.2, 0.6, 0.2, 0.0),
    // 角の柱と、戸口の枠
    model_text("box", beam, 2.1, 0.3, 2.1, 0.3, 2.9, 0.3, 0.0),
    model_text("box", beam, 9.9, 0.3, 2.1, 0.3, 2.9, 0.3, 0.0),
    model_text("box", beam, 2.1, 0.3, 7.9, 0.3, 2.9, 0.3, 0.0),
    model_text("box", beam, 9.9, 0.3, 7.9, 0.3, 2.9, 0.3, 0.0),
    model_text("box", beam, 5.33, 0.4, 2.05, 0.14, 2.3, 0.3, 0.0),
    model_text("box", beam, 6.67, 0.4, 2.05, 0.14, 2.3, 0.3, 0.0),
    model_text("box", beam, 6.0, 2.6, 2.05, 1.48, 0.14, 0.3, 0.0),
    // 窓（ガラスと枠）
    model_text("box", glass, 3.7, 1.3, 2.06, 1.2, 1.0, 0.2, 0.0),
    model_text("box", beam, 3.7, 1.2, 2.04, 1.4, 0.1, 0.3, 0.0),
    model_text("box", beam, 3.7, 2.3, 2.04, 1.4, 0.1, 0.3, 0.0),
    model_text("box", glass, 8.3, 1.3, 2.06, 1.2, 1.0, 0.2, 0.0),
