// 3 次元のブロックの世界で、AI の仲間「ユイ」と一緒に遊ぶ。
// 言葉でお願いすると、ユイが木を集めたり、家を建てたりしてくれる。
//
//   Enter                  お願いを書き始める（もう一度 Enter で送る、Esc でやめる）
//                          例: 「木を集めてきてー」「かわいいおうち建ててー」
//                          建物は、自由な形の部品を組んだ 3D モデルとして、少しずつ組み上がる。
//                          「/undo」と送ると、いちばん新しい建物を取り消す。
//                          「/sonnet」「/haiku」「/opus」と送ると、ユイの頭脳（モデル）を切り替える。
//                          opus がいちばん賢くて高く、sonnet は半額、haiku は 40 分の 1
//   W / A / S / D          歩く
//   ← / →  ↑ / ↓           向きを変える
//   スペース                跳ぶ
//   マウスの左ボタン または Q  画面の中央のブロックを壊す
//   マウスの右ボタン または E  画面の中央のブロックの手前に置く
//   1 〜 9、0              置くブロックを選ぶ
//   Esc                    終わる
//
// ユイの頭脳は Claude（Anthropic の API）。環境変数 ANTHROPIC_API_KEY に API キーを入れておく。
// キーがないときは、決まった返事（木を集める・家を建てる）だけをする。
//
//   yui build games/blocks_ai.yui -o blocks_ai.exe
//
// 引数: コマ数（0 なら自分で遊ぶ）、横の点の数、縦の点の数、自動で送るお願い（動作確認用。API は呼ばない）

import blocks_gpu
import claude
import json
import models

// ユイにしてもらうこと
struct Plan {
  say: String,
  // 建てるものの短い名前（建てないなら空）
  title: String,
  // 集めるブロックの種類と数（集めないなら 0 個）
  collect_kind: Int,
  collect_count: Int,
  // ブロックで建てるもの。部品 1 つにつき 8 個の数: 形, 種類, x1, y1, z1, x2, y2, z2（種類 0 は「空ける」）
  boxes: List<Int>,
  // 3D モデルとして建てるもの。部品 1 つにつき 9 個の小数（models.yui を参照）
  parts: List<Float>,
}

// ブロックの種類の名前（番号は blocks_gpu.kind_color と同じ）
fn kind_names() -> List<String> {
  [
    "air", "dirt", "stone", "wood", "leaves", "planks", "red", "white", "glass", "pink",
    "yellow", "brick", "dark_stone", "sandstone", "dark_wood", "roof_blue", "blue", "purple", "orange", "green",
    "black", "gray", "gold", "snow", "teal", "cream", "lavender", "mint", "rose", "lantern",
  ]
}

fn kind_of(name: String) -> Int {
  let names = kind_names()
  for i in 0..names.len() {
    if names[i] == name { return i }
  }
  -1
}

// 部品の形の名前
fn shape_names() -> List<String> {
  ["box", "walls", "cylinder", "tube", "pyramid", "gable_x", "gable_z", "cone", "checker", "dome"]
}

fn shape_of(name: String) -> Int {
  let names = shape_names()
  for i in 0..names.len() {
    if names[i] == name { return i }
  }
  0
}

fn kind_label(kind: Int) -> String {
  let labels = ["", "土", "石", "木", "葉", "板", "赤", "白", "水色", "ピンク", "黄"]
  if kind >= 0 && kind < labels.len() { labels[kind] } else { "" }
}

// ---- Claude とのやり取り ----

fn system_prompt() -> String {
  let lines = [
    "あなたは、3 次元の世界で遊ぶゲームの中の仲間「ユイ」です。",
    "プレイヤーのお願いを聞いて、木を集めたり、建物や物を作ったりして手伝います。明るく、親しみやすく、短く話します。",
    "立体を作るのがとても得意で、頼まれたものを、見ごたえのある凝った作りに仕上げます。",
    "",
    "返事は JSON で、次の項目を持ちます。",
    "- say: プレイヤーへのひとこと（プレイヤーと同じ言語で、40 文字以内）。",
    "- title: 作るものの短い名前（例: お城、赤い屋根のおうち）。プレイヤーと同じ言語で、12 文字以内。作らないときは空の文字列。",
    "- collect_kind と collect_count: 集めてくるブロックの種類と数。集めないときは \"none\" と 0。",
    "  集められるのは dirt（土）、stone（石）、wood（木の幹）、leaves（葉）。数は 1 から 40 まで。",
    "- model: 作るものを、立体の部品の並びで表します。作らないときは空の並び。",
    "",
    "座標と大きさ:",
    "- 単位はメートル。小数を使えます。x は横、z は奥行き、y は高さで、y = 0 が地面です。",
    "- 作るものは x が 0 から 24、z が 0 から 24 の範囲に収めます。高さは 60 まで。",
    "- プレイヤーは z の小さい側に立って見ているので、正面（入口）は z の小さい側に向けます。",
    "- プレイヤーの背の高さは 1.7。入口は幅 1.2・高さ 2.2 くらい、天井の高さは 2.8〜3.2、壁の厚さは 0.2〜0.3 が目安です。",
    "",
    "部品:",
    "- 部品は shape（形）、color（色）、位置 x・y・z、大きさ w・h・d、turn（回転）で表します。",
    "- x・z は部品の底面の中心、y は底面の高さです。w は横幅（x の向き）、h は高さ、d は奥行き（z の向き）。",
    "- turn は真上から見た回転で、単位は度。0 なら回しません。斜めの壁や、向きを変えた屋根に使います。",
    "- color は \"#rrggbb\" の形（例: \"#c0392b\"）。どんな色でも使えます。",
    "- 部品は中身の詰まった立体で、通り抜けられません。くり抜くことはできないので、部屋は壁・床・屋根を別々の薄い部品で囲んで作り、",
    "  入口は、壁を左右に分けて間を空け、その上に小さな壁（まぐさ）を渡して作ります。",
    "",
    "shape（形）:",
    "- box: 直方体。壁、床、柱、梁、窓枠、段など。",
    "- cylinder: 縦の円柱（w と d が直径）。塔、柱、煙突。",
    "- cone: 円すい。塔のとんがり屋根、木。",
    "- pyramid: 四角すい。四角い塔の屋根、尖塔。",
    "- roof: 三角屋根（棟が x の向きに走る三角柱）。棟を z の向きにしたいときは turn を 90 にします。",
    "- dome: 半球の丸屋根。 sphere: 球（w・h・d が直径）。植え込み、飾り玉、明かり。",
    "- wedge: z の大きい側へ向かって高くなる斜面。階段の代わりのスロープ、片流れの屋根、控え壁。",
    "",
    "見ごたえのあるものにするために:",
    "- 範囲を広く使い、頼まれたものにふさわしい大きさにします（家なら幅 8〜12、城や神殿なら範囲いっぱい、塔なら高さ 20 以上）。",
    "- 大きさと高さの違うかたまりを組み合わせます（母屋、張り出し、塔、玄関ポーチ、煙突、出窓、バルコニー）。",
    "- 色は、土台・壁・柱や梁・窓枠・屋根・飾りで変え、全体で 5〜8 色にまとめます。",
    "- 細い部品で細部を作ります: 窓は、ガラス（薄い水色の box）を壁から 0.05 だけ外に出して置き、まわりに枠を付けます。",
    "  軒は屋根を壁より 0.4〜0.6 張り出させます。手すり、柱、梁、ひさし、戸口の段、街灯、旗、植え込みを足します。",
    "- 同じ面にぴったり重なる部品は、ちらついて見えます。重ねるときは 0.03〜0.05 ずらします。",
    "- 部品は 200 個まで使えます。凝ったものなら 80〜200 個を目安にします。",
    "- 部品は書いた順に、少しずつ組み上がります。土台から上へ、大きいものから細部への順に書きます。",
    "",
    "集めることと作ることを同時に頼まれたら、両方を入れてかまいません。",
    "どちらでもないお願い（あいさつ、質問など）には、say だけで答えます。",
  ]
  lines.join("\n")
}

// 名前の並びを、JSON の文字列の並びにする
fn quoted(names: List<String>) -> String {
  names.map(|name| json.quote(name)).join(",")
}

// 返事の形（JSON スキーマ）
fn schema() -> String {
  let shapes = quoted(models.shape_names())
  let number = "\{\"type\":\"number\"}"
  let parts = [
    "\{\"type\":\"object\",\"properties\":\{\"say\":\{\"type\":\"string\"},\"title\":\{\"type\":\"string\"}",
    "\"collect_kind\":\{\"type\":\"string\",\"enum\":[\"none\",\"dirt\",\"stone\",\"wood\",\"leaves\"]}",
    "\"collect_count\":\{\"type\":\"integer\"}",
    "\"model\":\{\"type\":\"array\",\"items\":\{\"type\":\"object\",\"properties\":\{\"shape\":\{\"type\":\"string\",\"enum\":[{shapes}]}",
    "\"color\":\{\"type\":\"string\"}",
    "\"x\":{number},\"y\":{number},\"z\":{number},\"w\":{number},\"h\":{number},\"d\":{number},\"turn\":{number}}",
    "\"required\":[\"shape\",\"color\",\"x\",\"y\",\"z\",\"w\",\"h\",\"d\",\"turn\"],\"additionalProperties\":false}}}",
    "\"required\":[\"say\",\"title\",\"collect_kind\",\"collect_count\",\"model\"],\"additionalProperties\":false}",
  ]
  parts.join(",")
}

// 返事（JSON の文字列）を、してもらうことに直す
fn plan_from(reply: String) -> Result<Plan, String> {
  let v = json.parse(reply)?
  let mut boxes: List<Int> = []
  for item in json.items(json.get(v, "build")) {
    let kind = kind_of(json.text_of(json.get(item, "kind")))
    if kind >= 0 && boxes.len() < 8 * 200 {
      boxes = boxes.push(shape_of(json.text_of(json.get(item, "shape")))).push(kind)
      for name in ["x1", "y1", "z1", "x2", "y2", "z2"] {
        let limit = if name == "y1" || name == "y2" { 19 } else { 23 }
        boxes = boxes.push(json.int_of(json.get(item, name)).max(0).min(limit))
      }
    }
  }
  // 立体の部品。置き場所と大きさは、決めた範囲に収める
  let mut parts: List<Float> = []
  for item in json.items(json.get(v, "model")) {
    if parts.len() < 9 * 240 {
      parts = parts.push(models.shape_of(json.text_of(json.get(item, "shape"))).to_float())
      parts = parts.push(models.color_of(json.text_of(json.get(item, "color"))).to_float())
      parts = parts.push(json.float_of(json.get(item, "x")).max(-2.0).min(26.0))
      parts = parts.push(json.float_of(json.get(item, "y")).max(0.0).min(60.0))
      parts = parts.push(json.float_of(json.get(item, "z")).max(-2.0).min(26.0))
      parts = parts.push(json.float_of(json.get(item, "w")).max(0.02).min(28.0))
      parts = parts.push(json.float_of(json.get(item, "h")).max(0.02).min(60.0))
      parts = parts.push(json.float_of(json.get(item, "d")).max(0.02).min(28.0))
      parts = parts.push(json.float_of(json.get(item, "turn")))
    }
  }
  let collect_kind = kind_of(json.text_of(json.get(v, "collect_kind")))
  let count = json.int_of(json.get(v, "collect_count")).max(0).min(40)
  Ok(Plan {
    say: json.text_of(json.get(v, "say")),
    title: json.text_of(json.get(v, "title")),
    collect_kind: collect_kind,
    collect_count: if collect_kind >= 1 && collect_kind <= 4 { count } else { 0 },
    boxes: boxes,
    parts: parts,
  })
}

fn box_text(kind: String, x1: Int, y1: Int, z1: Int, x2: Int, y2: Int, z2: Int) -> String {
  "\{\"shape\":\"box\",\"kind\":\"{kind}\",\"x1\":{x1},\"y1\":{y1},\"z1\":{z1},\"x2\":{x2},\"y2\":{y2},\"z2\":{z2}}"
}

fn part_text(shape: String, kind: String, x1: Int, y1: Int, z1: Int, x2: Int, y2: Int, z2: Int) -> String {
  "\{\"shape\":\"{shape}\",\"kind\":\"{kind}\",\"x1\":{x1},\"y1\":{y1},\"z1\":{z1},\"x2\":{x2},\"y2\":{y2},\"z2\":{z2}}"
}

// 決まった返事のお城: 城壁、四隅の丸い塔、門、主塔、旗
fn canned_castle() -> String {
  let mut parts = [
    // 城壁と、その上のでこぼこ
    part_text("walls", "dark_stone", 2, 0, 2, 21, 5, 21),
    part_text("walls", "gray", 2, 6, 2, 21, 6, 21),
    part_text("checker", "air", 2, 6, 2, 21, 6, 21),
    // 門と、両脇の明かり
    part_text("box", "air", 11, 0, 2, 12, 3, 2),
    part_text("box", "dark_wood", 10, 4, 2, 13, 4, 2),
    part_text("box", "lantern", 10, 3, 1, 10, 3, 1),
    part_text("box", "lantern", 13, 3, 1, 13, 3, 1),
    // 主塔: 石の土台、クリーム色の壁、角の柱、窓、赤い屋根
    part_text("box", "stone", 7, 0, 8, 16, 1, 17),
    part_text("box", "cream", 8, 2, 9, 15, 10, 16),
    part_text("box", "air", 9, 1, 10, 14, 9, 15),
    part_text("box", "planks", 9, 0, 10, 14, 0, 15),
    part_text("box", "planks", 9, 5, 10, 14, 5, 15),
    part_text("box", "dark_wood", 8, 2, 9, 8, 10, 9),
    part_text("box", "dark_wood", 15, 2, 9, 15, 10, 9),
    part_text("box", "dark_wood", 8, 2, 16, 8, 10, 16),
    part_text("box", "dark_wood", 15, 2, 16, 15, 10, 16),
    part_text("box", "air", 11, 1, 8, 12, 3, 9),
    part_text("box", "glass", 10, 7, 9, 10, 8, 9),
    part_text("box", "glass", 13, 7, 9, 13, 8, 9),
    part_text("box", "glass", 8, 7, 12, 8, 8, 13),
    part_text("box", "glass", 15, 7, 12, 15, 8, 13),
    part_text("box", "glass", 8, 3, 12, 8, 4, 13),
    part_text("box", "glass", 15, 3, 12, 15, 4, 13),
    part_text("pyramid", "red", 7, 11, 8, 16, 15, 17),
    part_text("box", "gold", 11, 16, 12, 12, 16, 13),
    // 旗
    part_text("box", "dark_wood", 11, 17, 12, 11, 19, 12),
    part_text("box", "rose", 12, 18, 12, 13, 19, 12),
  ]
  // 四隅の丸い塔: 筒、窓、とんがり屋根
  for corner in 0..4 {
    let x = if corner % 2 == 0 { 0 } else { 19 }
    let z = if corner < 2 { 0 } else { 19 }
    parts = parts.push(part_text("tube", "stone", x, 0, z, x + 4, 9, z + 4))
    parts = parts.push(part_text("tube", "gray", x, 10, z, x + 4, 10, z + 4))
    parts = parts.push(part_text("box", "lantern", x + 2, 7, z, x + 2, 7, z + 4))
    parts = parts.push(part_text("box", "lantern", x, 7, z + 2, x + 4, 7, z + 2))
    parts = parts.push(part_text("box", "air", x + 2, 7, z + 1, x + 2, 7, z + 3))
    parts = parts.push(part_text("box", "air", x + 1, 7, z + 2, x + 3, 7, z + 2))
    parts = parts.push(part_text("cone", "roof_blue", x, 11, z, x + 4, 15, z + 4))
  }
  let joined = parts.join(",")
  "\{\"say\":\"りっぱなお城、建てるね！\",\"title\":\"お城\",\"collect_kind\":\"none\",\"collect_count\":0,\"build\":[{joined}]}"
}

fn model_text(
  shape: String,
  color: String,
  x: Float,
  y: Float,
  z: Float,
  w: Float,
  h: Float,
  d: Float,
  turn: Float,
) -> String {
  "\{\"shape\":\"{shape}\",\"color\":\"{color}\",\"x\":{x},\"y\":{y},\"z\":{z},\"w\":{w},\"h\":{h},\"d\":{d},\"turn\":{turn}}"
}

// 決まった返事の小屋（立体の部品で作る）: 三角屋根の母屋、丸い塔、煙突、戸口の段、街灯、植え込み
