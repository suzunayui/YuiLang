// 3 次元のブロックの世界。歩き回って、土・石・木を壊したり置いたりできる。
//
//   W / A / S / D          歩く
//   ← / →                  左右を向く
//   ↑ / ↓                  上下を向く
//   スペース                跳ぶ
//   マウスの左ボタン または Q  画面の中央のブロックを壊す
//   マウスの右ボタン または E  画面の中央のブロックの手前に置く
//   1 / 2 / 3 / 4          置くブロックを選ぶ（土 / 石 / 木 / 葉）
//   Esc                    終わる
//
// 絵は、画面の点 1 つずつ「視線の先にどのブロックがあるか」を計算して描いている。
// 計算が多いので、実行ファイルにしてから遊ぶ:
//   yui build games/blocks3d.yui -o blocks3d.exe
//
// 引数に数を渡すと、そのコマ数だけ自動で見回して終わる（動作確認用）。

// 世界は 横 32 × 高さ 20 × 奥行き 32 マス。マス (x, y, z) は表の (y * 32 + z) * 32 + x 番目。
// マスの中身: 0 = 空、1 = 土（上の面は草）、2 = 石、3 = 木、4 = 葉

struct Player {
  x: Float,
  y: Float,
  z: Float,
  fall: Float,
  turn: Float,
  tilt: Float,
}

// 三角関数。角度を -π〜π に直してから、級数で求める
fn sine(angle: Float) -> Float {
  let pi = 3.141592653589793
  let mut a = angle
  while a > pi {
    a = a - 2.0 * pi
  }
  while a < -pi {
    a = a + 2.0 * pi
  }
  let s = a * a
  a * (1.0 - s / 6.0 * (1.0 - s / 20.0 * (1.0 - s / 42.0 * (1.0 - s / 72.0 * (1.0 - s / 110.0 * (1.0 - s / 156.0 * (1.0 - s / 210.0)))))))
}

fn cosine(angle: Float) -> Float {
  sine(angle + 1.5707963267948966)
}

fn whole(value: Float) -> Int {
  value.floor().to_int()
}

// なだらかな丘を作り、木を何本か生やす
fn make_world(seed: Int) -> List<Int> uses io {
  random_seed(seed)
  let mut world = []
  for i in 0..20480 {
    world = world.push(0)
  }
  let a = random(628).to_float() / 100.0
  let b = random(628).to_float() / 100.0
  let c = random(628).to_float() / 100.0
  for z in 0..32 {
    for x in 0..32 {
      let fx = x.to_float()
      let fz = z.to_float()
      let hill = sine(fx * 0.35 + a) * 2.0 + sine(fz * 0.27 + b) * 2.0 + sine((fx + fz) * 0.15 + c) * 1.5
      let height = (7.0 + hill).round().to_int().max(2).min(14)
      for y in 0..height {
        world[(y * 32 + z) * 32 + x] = if y < height - 3 { 2 } else { 1 }
      }
    }
  }
  for tree in 0..14 {
    let x = 2 + random(28)
    let z = 2 + random(28)
    // その場所の地面の高さ
    let mut ground = 0
    for y in 0..20 {
      if world[(y * 32 + z) * 32 + x] != 0 {
        ground = y + 1
      }
    }
    if ground + 6 < 20 {
      for dy in 2..5 {
        for dz in 0..3 {
          for dx in 0..3 {
            if dy < 4 || dx == 1 && dz == 1 {
              world[((ground + dy) * 32 + z + dz - 1) * 32 + x + dx - 1] = 4
            }
          }
        }
      }
      for dy in 0..3 {
        world[((ground + dy) * 32 + z) * 32 + x] = 3
      }
    }
  }
  world
}

// (ox, oy, oz) から (dx, dy, dz) の向きへ進み、最初に当たるブロックを探す。
// マスの境目を 1 つずつまたいでいく（次に x・y・z のどの境目に先に着くかを比べる）。
// 当たらなければ -1。当たれば 距離 × 8 の整数部 × 262144 + マスの番号 × 8 + 面 を返す。
// 面: 0 / 1 = x の正 / 負の向きに進んで当たった、2 / 3 = y、4 / 5 = z
fn march(
  world: List<Int>,
  ox: Float,
  oy: Float,
  oz: Float,
  dx: Float,
  dy: Float,
  dz: Float,
) -> Int {
  let far = 1000000.0
  let mut ix = whole(ox)
  let mut iy = whole(oy)
  let mut iz = whole(oz)
  let sx = if dx > 0.0 { 1 } else { -1 }
  let sy = if dy > 0.0 { 1 } else { -1 }
  let sz = if dz > 0.0 { 1 } else { -1 }
  // マス 1 つ分進むのにかかる距離
  let gx = if dx == 0.0 { far } else { (1.0 / dx).abs() }
  let gy = if dy == 0.0 { far } else { (1.0 / dy).abs() }
  let gz = if dz == 0.0 { far } else { (1.0 / dz).abs() }
  // 次の境目までの距離
  let mut tx = if dx > 0.0 {
    (ix.to_float() + 1.0 - ox) * gx
  } else if dx < 0.0 {
    (ox - ix.to_float()) * gx
  } else {
    far
  }
  let mut ty = if dy > 0.0 {
    (iy.to_float() + 1.0 - oy) * gy
  } else if dy < 0.0 {
    (oy - iy.to_float()) * gy
  } else {
    far
  }
  let mut tz = if dz > 0.0 {
    (iz.to_float() + 1.0 - oz) * gz
  } else if dz < 0.0 {
    (oz - iz.to_float()) * gz
  } else {
    far
  }
  let mut steps = 0
  while steps < 80 {
    let mut distance = 0.0
    let mut face = 0
    if tx < ty && tx < tz {
      ix = ix + sx
      distance = tx
      tx = tx + gx
      face = if sx > 0 { 0 } else { 1 }
    } else if ty < tz {
      iy = iy + sy
      distance = ty
      ty = ty + gy
      face = if sy > 0 { 2 } else { 3 }
    } else {
      iz = iz + sz
      distance = tz
      tz = tz + gz
      face = if sz > 0 { 4 } else { 5 }
    }
    if ix < 0 || ix >= 32 || iz < 0 || iz >= 32 || iy < 0 { return -1 }
    if iy < 20 {
      let cell = (iy * 32 + iz) * 32 + ix
      if world[cell] != 0 { return (distance * 8.0).to_int() * 262144 + cell * 8 + face }
    } else if sy > 0 {
      return -1
    }
    steps = steps + 1
  }
  -1
}

// 明るさ（百分率）を掛け、遠いものほど空の色に近づける
fn mix(part: Int, light: Int, sky: Int, haze: Int) -> Int {
  (part * light / 100 * (256 - haze) + sky * haze) / 256
}

// march の結果から、その点の色を決める
fn color_of(world: List<Int>, hit: Int, target: Int) -> Int {
  if hit < 0 { return rgb(130, 185, 240) }
  let face = hit % 8
  let cell = hit / 8 % 32768
  let distance = hit / 262144
  let kind = world[cell]
  // 上から見える面は明るく、横は少し暗く、下は暗く
  let mut light = if face == 3 { 100 } else if face == 2 { 45 } else if face < 2 { 78 } else { 62 }
  if cell == target {
    light = light + 30
  }
  let haze = (distance * 5 / 4).min(230)
  let top = face == 3
  let r = if kind == 1 {
    if top { 96 } else { 134 }
  } else if kind == 2 {
    128
  } else if kind == 3 {
    110
  } else {
    60
  }
  let g = if kind == 1 {
    if top { 170 } else { 96 }
  } else if kind == 2 {
    128
  } else if kind == 3 {
    80
  } else {
    140
  }
  let b = if kind == 1 {
    if top { 76 } else { 67 }
  } else if kind == 2 {
    136
  } else if kind == 3 {
    44
  } else {
    56
  }
  rgb(mix(r, light, 130, haze), mix(g, light, 185, haze), mix(b, light, 240, haze))
}

// 点 (x, y, z) がブロックの中か。世界の外（横と下）は壁として扱う
fn solid(world: List<Int>, x: Float, y: Float, z: Float) -> Bool {
  let ix = whole(x)
  let iy = whole(y)
  let iz = whole(z)
  if ix < 0 || ix >= 32 || iz < 0 || iz >= 32 || iy < 0 { return true }
  if iy >= 20 { return false }
  world[(iy * 32 + iz) * 32 + ix] != 0
}

// 足元・腰・頭の高さで調べる
fn column(world: List<Int>, x: Float, y: Float, z: Float) -> Bool {
  solid(world, x, y, z) || solid(world, x, y + 0.9, z) || solid(world, x, y + 1.7, z)
}

// 足元が (x, y, z) の人（幅 0.6、高さ 1.7）がブロックに重なるか
fn blocked(world: List<Int>, x: Float, y: Float, z: Float) -> Bool {
  column(world, x - 0.3, y, z - 0.3) || column(world, x + 0.3, y, z - 0.3) || column(world, x - 0.3, y, z + 0.3) || column(world, x + 0.3, y, z + 0.3)
}

// 目の位置から見た世界を描く。target は印を付けるマス（なければ -1）
fn render(world: List<Int>, p: Player, target: Int, width: Int, height: Int) uses io {
  let st = sine(p.turn)
  let ct = cosine(p.turn)
  let sp = sine(p.tilt)
  let cp = cosine(p.tilt)
  // 前・右・上の向き
  let fx = cp * st
  let fy = sp
  let fz = cp * ct
  let rx = ct
  let rz = -st
  let ux = -sp * st
  let uy = cp
  let uz = -sp * ct
  let ex = p.x
  let ey = p.y + 1.6
  let ez = p.z
  let w = width.to_float()
  let h = height.to_float()
  let spread = 0.9
  for py in 0..height {
    let v = (h - 1.0 - 2.0 * py.to_float()) / w * spread
    for px in 0..width {
      let u = (2.0 * px.to_float() + 1.0 - w) / w * spread
      let hit = march(world, ex, ey, ez, fx + rx * u + ux * v, fy + uy * v, fz + rz * u + uz * v)
      draw_pixel(px, py, color_of(world, hit, target))
    }
  }
}

fn choice_color(kind: Int) -> Int {
  match kind {
    1 => rgb(96, 170, 76)
    2 => rgb(128, 128, 136)
    3 => rgb(110, 80, 44)
    _ => rgb(60, 140, 56)
  }
}

fn limit_from(xs: List<String>) -> Int {
  match xs.first() {
    Some(text) => text.to_int().unwrap_or(0)
    None => 0
  }
}

fn main() uses io {
  let width = 320
  let height = 200
  let limit = limit_from(args())
  window_open("YuiLang: blocks 3D", width, height, 3)
  let mut world = make_world(if limit > 0 { 7 } else { time_ms() })
  let mut p = Player { x: 16.5, y: 16.0, z: 16.5, fall: 0.0, turn: 0.6, tilt: -0.2 }
  let mut selected = 1
  let mut wait = 0
  let mut frame = 0
  let mut running = true
  while running {
    // 向きを変える
    if key_down("left") {
      p.turn = p.turn - 0.045
    }
    if key_down("right") {
      p.turn = p.turn + 0.045
    }
    if key_down("up") {
      p.tilt = (p.tilt + 0.035).min(1.4)
    }
    if key_down("down") {
      p.tilt = (p.tilt - 0.035).max(-1.4)
    }
    if limit > 0 {
      p.turn = p.turn + 0.03
    }

    // 歩く: 向いている方向を前として、横と前後を別々に動かす（壁に沿って滑れる）
    let st = sine(p.turn)
    let ct = cosine(p.turn)
    let mut mx = 0.0
    let mut mz = 0.0
    if key_down("w") {
      mx = mx + st
      mz = mz + ct
    }
    if key_down("s") {
      mx = mx - st
      mz = mz - ct
    }
    if key_down("d") {
      mx = mx + ct
      mz = mz - st
    }
    if key_down("a") {
      mx = mx - ct
      mz = mz + st
    }
    let nx = p.x + mx * 0.09
    if !blocked(world, nx, p.y, p.z) {
      p.x = nx
    }
    let nz = p.z + mz * 0.09
    if !blocked(world, p.x, p.y, nz) {
      p.z = nz
    }

    // 跳ぶ・落ちる
    let standing = blocked(world, p.x, p.y - 0.05, p.z)
    if standing && key_down("space") {
      p.fall = 0.21
    }
    p.fall = (p.fall - 0.012).max(-0.5)
    let ny = p.y + p.fall
    if blocked(world, p.x, ny, p.z) {
      p.fall = 0.0
    } else {
      p.y = ny
    }

    // 画面の中央の先にあるブロック（手の届く範囲だけ）
    let sp = sine(p.tilt)
    let cp = cosine(p.tilt)
    let aim = march(world, p.x, p.y + 1.6, p.z, cp * st, sp, cp * ct)
    let reach = aim >= 0 && aim / 262144 < 48
    let target = if reach { aim / 8 % 32768 } else { -1 }

    // 置くブロックを選ぶ
    if key_down("1") {
      selected = 1
    }
    if key_down("2") {
      selected = 2
    }
    if key_down("3") {
      selected = 3
    }
    if key_down("4") {
      selected = 4
    }

    // 壊す・置く（押しっぱなしで連続しすぎないよう、少し間をあける）
    if wait > 0 {
      wait = wait - 1
    }
    if reach && wait == 0 && (mouse_down(0) || key_down("q")) {
      world[target] = 0
      wait = 10
    }
    if reach && wait == 0 && (mouse_down(1) || key_down("e")) {
      // 当たった面の手前のマス
      let face = aim % 8
      let back = if face == 0 {
        -1
      } else if face == 1 {
        1
      } else if face == 2 {
        -1024
      } else if face == 3 {
        1024
      } else if face == 4 {
        -32
      } else {
        32
      }
      let place = target + back
      if place >= 0 && place < 20480 && world[place] == 0 {
        world[place] = selected
        // 自分に重なる場所には置けない
        if blocked(world, p.x, p.y, p.z) {
          world[place] = 0
        }
      }
      wait = 10
    }

    // 描く
    render(world, p, target, width, height)
    let cx = width / 2
    let cy = height / 2
    draw_rect(cx - 4, cy, 9, 1, rgb(255, 255, 255))
    draw_rect(cx, cy - 4, 1, 9, rgb(255, 255, 255))
    for kind in 1..5 {
      let x = 6 + (kind - 1) * 18
      if kind == selected { draw_rect(x - 2, height - 20, 16, 16, rgb(255, 255, 255)) }
      draw_rect(x, height - 18, 12, 12, choice_color(kind))
    }

    frame = frame + 1
    if !window_update() || key_down("escape") || limit > 0 && frame >= limit {
      running = false
    }
    sleep_ms(8)
  }
  window_close()
  print("frames: {frame}, position: {p.x} {p.y} {p.z}")
}
