// YuiLang の字句解析を YuiLang で書いたもの。
// Rust 版（src/lexer.rs）と同じトークン列を作ることを、テストで全サンプルについて確かめている。
//
// 出力は1トークン1行。行頭は、そのトークンがソースの行の先頭なら `+`、そうでなければ空白。
// 続けて `int 42`、`float 1.5`、`ident name`、`kw fn`、`sym ->`、`eof`、
// または `str` とタブ区切りの部品（文字列そのものは `L:...`、補間の中身は `C:...`）。
// エラーが見つかったら、そこまでのトークンのあとに `error E0001` のような行を出して終わる。

// 文字列リテラルを読んだ結果。失敗したときは text がエラーコード
struct Scan {
  next: Int,
  text: String,
  ok: Bool,
}

fn is_digit(c: Int) -> Bool {
  c >= '0' && c <= '9'
}

fn is_alpha(c: Int) -> Bool {
  c >= 'A' && c <= 'Z' || c >= 'a' && c <= 'z' || c == '_'
}

fn is_keyword(word: String) -> Bool {
  let keywords = [
    "fn",
    "let",
    "mut",
    "if",
    "else",
    "while",
    "for",
    "in",
    "match",
    "return",
    "break",
    "continue",
    "struct",
    "enum",
    "test",
    "import",
    "assert",
    "uses",
    "requires",
    "ensures",
    "true",
    "false",
  ]
  keywords.contains(word)
}

fn text(chars: List<String>, from: Int, to: Int) -> String {
  chars.slice(from, to).join("")
}

fn escape(s: String) -> String {
  s.replace("\\", "\\\\").replace("\n", "\\n").replace("\t", "\\t").replace("\r", "\\r")
}

fn failed(code: String, at: Int) -> Scan {
  Scan { next: at, text: code, ok: false }
}

// エスケープ `\x` の x の文字コードから、それが表す文字を返す
fn unescape(code: Int) -> Option<String> {
  match code {
    'n' => Some("\n")
    't' => Some("\t")
    'r' => Some("\r")
    '\\' => Some("\\")
    '"' => Some("\"")
    '{' => Some("\{")
    '}' => Some("\}")
    _ => None
  }
}

// open にある `"` から始まる文字列リテラルを読む
fn scan_string(chars: List<String>, codes: List<Int>, open: Int) -> Scan {
  let n = codes.len()
  let mut i = open + 1
  let mut parts = "str"
  let mut count = 0
  let mut cur = ""
  while true {
    if i >= n { return failed("E0002", i) }
    let c = codes[i]
    if c == '"' {
      i = i + 1
      break
    }
    if c == '\n' { return failed("E0002", i) }
    if c == '\\' {
      if i + 1 >= n { return failed("E0004", i) }
      match unescape(codes[i + 1]) {
        Some(ch) => {
          cur = "{cur}{ch}"
        }
        None => return failed("E0004", i)
      }
      i = i + 2
      continue
    }
    if c == '{' {
      // `{式}`: 対応する `}` までをそのまま取り出す
      let code_start = i + 1
      let mut depth = 1
      let mut j = code_start
      while true {
        if j >= n { return failed("E0002", j) }
        let d = codes[j]
        if d == '\n' { return failed("E0002", j) }
        if d == '{' {
          depth = depth + 1
        } else if d == '}' {
          depth = depth - 1
          if depth == 0 { break }
        } else if d == '"' {
          // 式の中の文字列: 終わりまで飛ばす（中の波かっこや引用符を数えないように）
          let inner = if is_raw_start(codes, j) {
            scan_raw(chars, codes, j)
          } else {
            scan_string(chars, codes, j)
          }
          if !inner.ok { return inner }
          j = inner.next
          continue
        } else if d == '\'' {
          // 式の中の文字リテラル（'}' や '"' など）
          let end = scan_char(codes, j)
          if end >= 0 {
            j = end
            continue
          }
        }
        j = j + 1
      }
      if !cur.is_empty() {
        parts = "{parts}\tL:{escape(cur)}"
        count = count + 1
        cur = ""
      }
      parts = "{parts}\tC:{escape(text(chars, code_start, j))}"
      count = count + 1
      i = j + 1
      continue
    }
    cur = "{cur}{chars[i]}"
    i = i + 1
  }
  if !cur.is_empty() || count == 0 {
    parts = "{parts}\tL:{escape(cur)}"
  }
  Scan { next: i, text: parts, ok: true }
}

// at から `"""` が始まっているか
fn is_raw_start(codes: List<Int>, at: Int) -> Bool {
  at + 2 < codes.len() && codes[at] == '"' && codes[at + 1] == '"' && codes[at + 2] == '"'
}

// open にある `"""` から始まる、そのまま書ける文字列を読む。
// 中身に特別な文字はない。配置のための決まりは 2 つ:
// 開く `"""` の直後の改行は中身に入らない。閉じる `"""` が単独の行にあれば、
// その前の空白が各行の頭から取り除かれ、直前の改行も中身に入らない
fn scan_raw(chars: List<String>, codes: List<Int>, open: Int) -> Scan {
  let n = codes.len()
  let start = open + 3
  let mut end = start
  while end < n && !is_raw_start(codes, end) {
    end = end + 1
  }
  if end >= n { return failed("E0002", n) }
  let raw = text(chars, start, end).replace("\r\n", "\n")
  let next = end + 3
  if !raw.starts_with("\n") { return Scan { next: next, text: "str\tL:{escape(raw)}", ok: true } }
  let body = raw.slice(1, raw.len())
  let lines = body.split("\n")
  let indent = lines[lines.len() - 1]
  let plain = lines.len() < 2 || indent.codes().any(|c| c != ' ' && c != '\t')
  if plain { return Scan { next: next, text: "str\tL:{escape(body)}", ok: true } }
  let mut kept: List<String> = []
  for i in 0..lines.len() - 1 {
    let line = lines[i]
    if line.starts_with(indent) {
      kept = kept.push(line.slice(indent.len(), line.len()))
    } else if line.trim().is_empty() {
      // 空の行は字下げがなくてもよい
      kept = kept.push("")
    } else {
      return failed("E0007", next)
    }
  }
  Scan { next: next, text: "str\tL:{escape(kept.join("\n"))}", ok: true }
}

// open にある `'` から始まる文字リテラルを読み、その直後の位置を返す。正しくなければ -1
fn scan_char(codes: List<Int>, open: Int) -> Int {
  let n = codes.len()
  if open + 1 >= n { return 0 - 1 }
  let c = codes[open + 1]
  let mut close = open + 2
  if c == '\\' {
    if open + 2 >= n { return 0 - 1 }
    let e = codes[open + 2]
    let known = e == 'n' || e == 't' || e == 'r' || e == '\\' || e == '\'' || e == '"'
    if !known { return 0 - 1 }
    close = open + 3
  } else if c == '\'' || c == '\n' {
    return 0 - 1
  }
  if close < n && codes[close] == '\'' { close + 1 } else { 0 - 1 }
}

fn lex(src: String) -> List<String> {
  let chars = src.chars()
  let codes = src.codes()
  let n = codes.len()
  let two_char = ["..", "->", "=>", "==", "!=", "<=", ">=", "&&", "||"]
  let one_char = "()\{\}[],:.=<>+-*/%!?|"
  let mut out = []
  let mut i = 0
  // 次のトークンがソースの行の先頭かどうか
  let mut nl = true
  while i < n {
    let c = codes[i]
    if c == '\n' {
      nl = true
      i = i + 1
      continue
    }
    if c == ' ' || c == '\t' || c == '\r' {
      i = i + 1
      continue
    }
    if c == '/' && i + 1 < n && codes[i + 1] == '/' {
      while i < n && codes[i] != '\n' && codes[i] != '\r' {
        i = i + 1
      }
      continue
    }
    let mark = if nl { "+" } else { " " }
    let start = i
    if is_digit(c) {
      while i < n && (is_digit(codes[i]) || codes[i] == '_') {
        i = i + 1
      }
      let mut is_float = false
      if i + 1 < n && codes[i] == '.' && is_digit(codes[i + 1]) {
        is_float = true
        i = i + 1
        while i < n && (is_digit(codes[i]) || codes[i] == '_') {
          i = i + 1
        }
      }
      let digits = text(chars, start, i).replace("_", "")
      if is_float {
        out = out.push("{mark}float {digits}")
      } else if digits.to_int().is_some() {
        out = out.push("{mark}int {digits}")
      } else {
        // Int（64bit）に収まらない
        return out.push("error E0003")
      }
    } else if is_alpha(c) {
      while i < n && (is_alpha(codes[i]) || is_digit(codes[i])) {
        i = i + 1
      }
      let word = text(chars, start, i)
      let kind = if is_keyword(word) { "kw" } else { "ident" }
      out = out.push("{mark}{kind} {word}")
    } else if c == '\'' {
      let end = scan_char(codes, i)
      if end < 0 { return out.push("error E0006") }
      out = out.push("{mark}int {text(chars, start, end)}")
      i = end
    } else if c == '"' {
      let scan = if is_raw_start(codes, i) {
        scan_raw(chars, codes, i)
      } else {
        scan_string(chars, codes, i)
      }
      if !scan.ok { return out.push("error {scan.text}") }
      out = out.push("{mark}{scan.text}")
      i = scan.next
    } else {
      let pair = if i + 1 < n { text(chars, i, i + 2) } else { "" }
      if two_char.contains(pair) {
        out = out.push("{mark}sym {pair}")
        i = i + 2
      } else if one_char.contains(chars[i]) {
        out = out.push("{mark}sym {chars[i]}")
        i = i + 1
      } else {
        return out.push("error E0001")
      }
    }
    nl = false
  }
  let mark = if nl { "+" } else { " " }
  out.push("{mark}eof")
}

test "numbers and names" {
  assert lex("let x = 1_000 + 2.5") == ["+kw let", " ident x", " sym =", " int 1000", " sym +", " float 2.5", " eof"]
  assert lex("0..10") == ["+int 0", " sym ..", " int 10", " eof"]
  assert lex("1.to_float()") == ["+int 1", " sym .", " ident to_float", " sym (", " sym )", " eof"]
}

test "lines and comments" {
  assert lex("a // note\nb") == ["+ident a", "+ident b", " eof"]
  assert lex("a\n") == ["+ident a", "+eof"]
  assert lex("") == ["+eof"]
}

test "strings" {
  assert lex("\"hi\"") == ["+str\tL:hi", " eof"]
  assert lex("\"\"") == ["+str\tL:", " eof"]
  assert lex("\"a\{b\}c\"") == ["+str\tL:a\tC:b\tL:c", " eof"]
  assert lex("\"\\n\"") == ["+str\tL:\\n", " eof"]
}

test "strings inside interpolation" {
  assert lex("\"a\{f(\"x\")\}b\"") == ["+str\tL:a\tC:f(\"x\")\tL:b", " eof"]
  assert lex("\"\{m.get(\"\}\")\}\"") == ["+str\tC:m.get(\"\}\")", " eof"]
  assert lex("\"\{c == '\}'\}\"") == ["+str\tC:c == '\}'", " eof"]
  assert lex("\"\{\"abc\}\"") == ["error E0002"]
}

test "raw strings" {
  assert lex("\"\"\"a \"b\" \{c\} \\n\"\"\"") == ["+str\tL:a \"b\" \{c\} \\\\n", " eof"]
  assert lex("\"\"\"\"\"\"") == ["+str\tL:", " eof"]
  assert lex("x = \"\"\"\n  one\n\n    two\n  \"\"\" y") == ["+ident x", " sym =", " str\tL:one\\n\\n  two", " ident y", " eof"]
  assert lex("\"\"\"\n  one\n two\n  \"\"\"") == ["error E0007"]
  assert lex("\"\"\"\none\ntwo\"\"\"") == ["+str\tL:one\\ntwo", " eof"]
  assert lex("\"\"\"abc") == ["error E0002"]
}

test "character literals" {
  assert lex("'a' '\\n' '\\''") == ["+int 'a'", " int '\\n'", " int '\\''", " eof"]
  assert lex("'ab'") == ["error E0006"]
  assert lex("''") == ["error E0006"]
}

test "errors" {
  assert lex("a ; b") == ["+ident a", "error E0001"]
  assert lex("x = \"abc") == ["+ident x", " sym =", "error E0002"]
  assert lex("99999999999999999999") == ["error E0003"]
  assert lex("\"\\q\"") == ["error E0004"]
}

fn main() uses io, fs {
  for path in args() {
    match read_file(path) {
      Ok(src) => {
        for line in lex(src) {
          print(line)
        }
      }
      Err(message) => print("error {message}")
    }
  }
}
