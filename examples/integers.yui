// 整数の計算とループ。JIT は整数の変数と式をレジスタに置くので、その経路をひととおり通す

fn fib(n: Int) -> Int {
  if n < 2 { n } else { fib(n - 1) + fib(n - 2) }
}

fn label(n: Int) -> String {
  "{n}"
}

fn sum_while(n: Int) -> Int {
  let mut total = 0
  let mut i = 0
  while i < n {
    total = total + i * 2 - i % 3
    i = i + 1
  }
  total
}

fn collatz_steps(n: Int) -> Int {
  let mut x = n
  let mut steps = 0
  while x != 1 {
    if x % 2 == 0 {
      x = x / 2
    } else {
      x = x * 3 + 1
    }
    steps = steps + 1
  }
  steps
}

fn count_primes(limit: Int) -> Int {
  let mut count = 0
  for n in 2..limit {
    let mut is_prime = true
    let mut d = 2
    while d * d <= n {
      if n % d == 0 {
        is_prime = false
        break
      }
      d = d + 1
    }
    if is_prime {
      count = count + 1
    }
  }
  count
}

fn gcd(a: Int, b: Int) -> Int {
  let mut x = a
  let mut y = b
  while y != 0 {
    let t = x % y
    x = y
    y = t
  }
  x
}

// ループの中で関数を呼ぶ（レジスタ上の変数は呼び出しをまたいで保たれる）
fn mixed(n: Int) -> Int {
  let mut total = 0
  for i in 0..n {
    total = total + fib(i % 10) + label(i).len()
  }
  total
}

fn skip_sum(n: Int) -> Int {
  let mut total = 0
  for i in 0..n {
    if i % 2 == 0 { continue }
    if i > 7 { break }
    total = total + i
  }
  total
}

// レジスタの数より多い整数の変数
fn grid(n: Int) -> Int {
  let mut total = 0
  for a in 0..n {
    for b in 0..n {
      let c = a * b
      if c % 2 == 1 {
        total = total + c
      } else {
        total = total - 1
      }
    }
  }
  total
}

// 式の途中の値が多い
fn deep(a: Int, b: Int, c: Int, d: Int, e: Int, f: Int, g: Int, h: Int) -> Int {
  a + (b + (c + (d + (e + (f + (g + (h + 1)))))))
}

fn largest(a: Int, b: Int, c: Int) -> Int {
  let m = if a > b { a } else { b }
  if m > c { m } else { c }
}

fn both_positive(x: Int, y: Int) -> Bool {
  x > 0 && y > 0
}

fn power(base: Int, exp: Int) -> Int
  requires exp >= 0
{
  let mut result = 1
  for _ in 0..exp {
    result = result * base
  }
  result
}

test "loops" {
  assert sum_while(10) == 81
  assert collatz_steps(6) == 8
  assert collatz_steps(27) == 111
  assert count_primes(100) == 25
  assert count_primes(1000) == 168
  assert gcd(1071, 462) == 21
  assert skip_sum(20) == 16
  assert grid(4) == 4
  assert power(2, 62) == 4611686018427387904
  assert power(7, 0) == 1
}

test "calls inside loops" {
  assert mixed(20) == 206
  let mut total = 0
  for i in 0..15 {
    total = total + fib(i)
  }
  assert total == 986
}

test "expressions" {
  assert deep(1, 2, 3, 4, 5, 6, 7, 8) == 37
  assert largest(3, 9, 5) == 9
  assert largest(3, 2, 5) == 5
  assert both_positive(1, 2)
  assert !both_positive(1, 0 - 2)
  let x = 5
  let y = 7
  let less = x < y
  let same = x == y
  assert less
  assert !same
  let big = 9223372036854775806
  assert big + 1 == 9223372036854775807
  assert 0 - big - 2 == 0 - 9223372036854775807 - 1
}

test "closures see copies of loop variables" {
  let mut adders = []
  for i in 0..3 {
    let k = i * 10
    adders = adders.push(|x| x + k + i)
  }
  assert adders.map(|f| f(1)) == [1, 12, 23]
  let mut n = 0
  let bump = |x: Int| x + n
  for i in 0..5 {
    n = n + i
  }
  assert bump(1) == 1
  assert n == 10
}

fn main() uses io {
  print("primes below 10000: {count_primes(10000)}")
  print("collatz(97) takes {collatz_steps(97)} steps")
  print("2^40 = {power(2, 40)}")
}

test "bits and character codes" {
  assert 12.bit_and(10) == 8
  assert 12.bit_or(10) == 14
  assert 12.bit_xor(10) == 6
  assert 1.shl(10) == 1024
  assert 1024.shr(3) == 128
  assert (0 - 8).shr(1) == 0 - 4
  assert 1.shl(63).shr(63) == 0 - 1
  assert "Aあ".codes() == [65, 12354]
  assert 65.to_char() == "A"
  assert 12354.to_char() == "あ"
  assert "abc".codes().map(|c| (c + 1).to_char()).join("") == "bcd"
}
