// v0.1 の機能をひととおり使うサンプル

struct Point {
  x: Int,
  y: Int,
}

enum Shape {
  Circle(Float),
  Rect(Float, Float),
  Empty,
}

fn area(s: Shape) -> Float {
  match s {
    Shape.Circle(r) => 3.0 * r * r
    Shape.Rect(w, h) => w * h
    Shape.Empty => 0.0
  }
}

fn clamp(x: Int, lo: Int, hi: Int) -> Int
  requires lo <= hi
  ensures result >= lo && result <= hi
{
  if x < lo { lo } else if x > hi { hi } else { x }
}

fn sum(xs: List<Int>) -> Int {
  let mut total = 0
  for x in xs {
    total = total + x
  }
  total
}

fn squares(n: Int) -> List<Int> {
  let mut out = []
  for i in 0..n {
    out = out.push(i * i)
  }
  out
}

fn parse_pair(a: String, b: String) -> Option<Int> {
  let x = a.to_int()?
  let y = b.to_int()?
  Some(x + y)
}

fn fib(n: Int) -> Int
  requires n >= 0
{
  if n < 2 { n } else { fib(n - 1) + fib(n - 2) }
}

fn first_even(xs: List<Int>) -> Option<Int> {
  for x in xs {
    if x % 2 == 0 { return Some(x) }
  }
  None
}

fn move_right(p: Point, dx: Int) -> Point {
  let mut q = p
  q.x = q.x + dx
  q
}

test "shapes" {
  assert area(Shape.Circle(1.0)) == 3.0
  assert area(Shape.Rect(2.0, 3.0)) == 6.0
  assert area(Shape.Empty) == 0.0
}

test "clamp" {
  assert clamp(5, 0, 10) == 5
  assert clamp(-5, 0, 10) == 0
  assert clamp(50, 0, 10) == 10
}

test "lists" {
  assert sum([1, 2, 3]) == 6
  assert squares(4) == [0, 1, 4, 9]
  assert squares(4).len() == 4
  assert squares(4).get(10) == None
  assert first_even([1, 3, 4, 5]) == Some(4)
  assert first_even([1, 3]) == None
}

test "option and ?" {
  assert parse_pair("1", "2") == Some(3)
  assert parse_pair("1", "x") == None
  assert parse_pair("1", "x").unwrap_or(0) == 0
}

test "value semantics" {
  let p = Point { x: 1, y: 2 }
  let q = move_right(p, 10)
  assert p.x == 1
  assert q == Point { x: 11, y: 2 }

  let mut xs = [1, 2, 3]
  let ys = xs
  xs[0] = 99
  assert ys == [1, 2, 3]
  assert xs == [99, 2, 3]
}

test "strings" {
  let name = "Yui"
  assert "hello, {name}!" == "hello, Yui!"
  assert "{1 + 2}" == "3"
  assert "  padded ".trim().len() == 6
  assert "{Point { x: 1, y: 2 }}" == "Point \{ x: 1, y: 2 \}"
}

test "loops" {
  let mut i = 0
  let mut evens = 0
  while true {
    i = i + 1
    if i > 10 { break }
    if i % 2 == 1 { continue }
    evens = evens + 1
  }
  assert evens == 5
  assert fib(10) == 55
}

fn main() uses io {
  print("area: {area(Shape.Rect(2.0, 3.0))}")
  print("squares: {squares(5)}")
  print("fib(20) = {fib(20)}")
  print("point: {move_right(Point { x: 0, y: 0 }, 3)}")
}

enum Flags {
  Pair(Bool, Bool),
}

// 複数フィールドの場合分けも、網羅していれば通る
fn code(f: Flags) -> Int {
  match f {
    Flags.Pair(true, true) => 3
    Flags.Pair(true, false) => 2
    Flags.Pair(false, _) => 1
  }
}

test "nested patterns" {
  assert code(Flags.Pair(true, false)) == 2
  assert code(Flags.Pair(false, true)) == 1
}
