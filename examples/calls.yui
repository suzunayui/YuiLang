// 関数呼び出しのいろいろな形。JIT の速い経路と、そこから外れる場合の両方を通す

fn fib(n: Int) -> Int {
  if n < 2 { n } else { fib(n - 1) + fib(n - 2) }
}

// 相互再帰: 呼び出す時点で相手がまだ機械語になっていない
fn is_even(n: Int) -> Bool {
  if n == 0 { true } else { is_odd(n - 1) }
}

fn is_odd(n: Int) -> Bool {
  if n == 0 { false } else { is_even(n - 1) }
}

fn ackermann(m: Int, n: Int) -> Int {
  if m == 0 {
    n + 1
  } else if n == 0 {
    ackermann(m - 1, 1)
  } else {
    ackermann(m - 1, ackermann(m, n - 1))
  }
}

// 引数以外のローカル変数を持つ
fn sum_to(n: Int) -> Int {
  let mut total = 0
  let mut i = 1
  while i <= n {
    total = total + i
    i = i + 1
  }
  total
}

// 文字列のローカル変数を持つ（復帰のときに後始末が必要）
fn label_length(n: Int) -> Int {
  let label = "item {n}"
  label.len()
}

// 整数だけのローカル変数から、リストを返す
fn pair(a: Int, b: Int) -> List<Int> {
  [a, b]
}

// 戻り値のない関数
fn ignore(n: Int) {
  let _ = n + 1
}

// ローカル変数が多い
fn many_locals(x: Int) -> Int {
  let a = x + 1
  let b = a + 1
  let c = b + 1
  let d = c + 1
  let e = d + 1
  let f = e + 1
  let g = f + 1
  let h = g + 1
  let i = h + 1
  let j = i + 1
  a + b + c + d + e + f + g + h + i + j
}

fn checked_half(n: Int) -> Int
  requires n % 2 == 0
  ensures result * 2 == n
{
  n / 2
}

fn count_down(n: Int) -> Int {
  if n == 0 { 0 } else { 1 + count_down(n - 1) }
}

test "recursion" {
  assert fib(20) == 6765
  assert is_even(10)
  assert is_odd(7)
  assert ackermann(2, 3) == 9
  assert count_down(5000) == 5000
}

test "locals" {
  assert sum_to(100) == 5050
  assert label_length(12345) == 10
  assert many_locals(0) == 55
}

test "results" {
  assert pair(1, 2) == [1, 2]
  assert pair(3, 4).len() == 2
  let mut total = 0
  for i in 0..100 {
    ignore(i)
    total = total + checked_half(i * 2)
  }
  assert total == 4950
}

test "calls inside closures" {
  let xs = [1, 2, 3, 4, 5]
  assert xs.map(|x| fib(x)) == [1, 1, 2, 3, 5]
  assert xs.map(sum_to) == [1, 3, 6, 10, 15]
  assert xs.fold(0, |acc, x| acc + label_length(x)) == 30
}

fn main() uses io {
  print("fib(25) = {fib(25)}")
  print("ackermann(2, 3) = {ackermann(2, 3)}")
  print("{pair(sum_to(10), label_length(7))}")
}
